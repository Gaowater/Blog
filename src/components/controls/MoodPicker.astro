---
import { Icon } from "astro-icon/components";

// 12 个心情选项（fa7-regular 黑色线条图标）
const moods = [
  { icon: "fa7-regular:face-grin-beam", label: "愉悦" },
  { icon: "fa7-regular:face-smile-beam", label: "悠闲" },
  { icon: "fa7-regular:face-laugh-squint", label: "期待" },
  { icon: "fa7-regular:face-laugh-beam", label: "自由" },
  { icon: "fa7-regular:face-frown", label: "悲伤" },
  { icon: "fa7-regular:face-meh-blank", label: "孤独" },
  { icon: "fa7-regular:face-grimace", label: "愤怒" },
  { icon: "fa7-regular:face-frown-open", label: "遗憾" },
  { icon: "fa7-regular:face-meh", label: "无聊" },
  { icon: "fa7-regular:face-rolling-eyes", label: "空虚" },
  { icon: "fa7-regular:face-grin-stars", label: "发癫" },
  { icon: "fa7-regular:face-grin-hearts", label: "想你" },
];

const defaultIcon = "fa7-brands:gratipay";
---

<div id="mood-picker" class="relative inline-flex">
  <!-- ═══ 触发按钮（默认心形，选中后变对应 emoji） ═══ -->
  <button
    id="mood-picker-btn"
    class="btn-plain scale-animation rounded-lg h-11 w-11 active:scale-90 cursor-pointer"
    aria-label="选择心情"
    title="选择心情"
  >
    <!-- 默认：Iconify 心形 -->
    <span class="mood-icon-elem" data-mood-key="fa7-brands:gratipay">
      <Icon name={defaultIcon} is:inline class="text-[1.25rem]" />
    </span>
    <!-- 选中后：黑色线条图标 -->
    {moods.map((mood) => (
      <span
        class="mood-icon-elem hidden"
        data-mood-key={mood.icon}
      ><Icon name={mood.icon} is:inline class="text-[1.25rem] text-neutral-900 dark:text-neutral-100" /></span>
    ))}
  </button>

  <!-- ═══ 下拉面板 ═══ -->
  <div
    id="mood-picker-panel"
    class="float-panel float-panel-closed absolute top-full mt-2 p-3 z-50
           w-72 max-sm:w-64
           max-sm:left-1/2 max-sm:-translate-x-1/2 max-sm:right-auto
           sm:right-0"
  >
    <!-- ═══ 初次使用：身份选择 ═══ -->
    <div id="mood-setup" class="hidden">
      <p class="text-sm text-center mb-3 text-neutral-700 dark:text-neutral-300">你是谁？</p>
      <div class="flex justify-center gap-3">
        <button id="setup-mh" data-user="mouhe"
          class="rounded-lg px-6 py-2 text-sm font-semibold transition
                 bg-(--btn-regular-bg) hover:opacity-80 active:scale-90 cursor-pointer"
        >MH</button>
        <button id="setup-hyl" data-user="yiliu"
          class="rounded-lg px-6 py-2 text-sm font-semibold transition
                 bg-(--btn-regular-bg) hover:opacity-80 active:scale-90 cursor-pointer"
        >HYL</button>
      </div>
    </div>

    <!-- ═══ 正式面板（身份绑定后显示） ═══ -->
    <div id="mood-main" class="hidden">
      <!-- 两人心情状态 -->
      <div id="mood-status" class="mb-3">
        <div class="flex items-center justify-center gap-3 text-sm">
          <span class="text-xs text-neutral-500 dark:text-neutral-400">你的心情</span>
          <span id="mood-mine-icons" class="inline-flex items-center">
            <span id="mood-mine-default" class="text-[1.1rem]">—</span>
            {moods.map((mood) => (
              <Icon name={mood.icon} is:inline class="mood-mine-icon hidden text-[1.1rem] text-neutral-900 dark:text-neutral-100" data-mood-icon={mood.icon} />
            ))}
          </span>
          <span id="mood-mine-label" class="text-[0.65rem] text-neutral-500 dark:text-neutral-400">未设置</span>
        </div>
        <div class="flex items-center justify-center gap-3 text-sm mt-1">
          <span class="text-xs text-neutral-500 dark:text-neutral-400">对方的心情</span>
          <span id="mood-theirs-icons" class="inline-flex items-center">
            <span id="mood-theirs-default" class="text-[1.1rem]">—</span>
            {moods.map((mood) => (
              <Icon name={mood.icon} is:inline class="mood-theirs-icon hidden text-[1.1rem] text-neutral-900 dark:text-neutral-100" data-mood-icon={mood.icon} />
            ))}
          </span>
          <span id="mood-theirs-label" class="text-[0.65rem] text-neutral-500 dark:text-neutral-400">未设置</span>
        </div>
      </div>

      <!-- 两人心情状态 -->
      <div id="mood-status" class="mb-3">
      <div class="grid grid-cols-3 gap-1.5">
        {moods.map((mood) => (
          <button
            data-mood-icon={mood.icon}
            data-mood-label={mood.label}
            class="mood-option flex flex-col items-center justify-center gap-0.5 rounded-lg py-2 px-1 transition hover:bg-(--btn-regular-bg) active:scale-90 cursor-pointer"
          >
            <Icon name={mood.icon} is:inline class="text-[1.375rem] text-neutral-900 dark:text-neutral-100" />
            <span class="text-[0.7rem] leading-tight text-neutral-900 dark:text-neutral-100 whitespace-nowrap">{mood.label}</span>
          </button>
        ))}
      </div>

      <!-- 重置 -->
      <div class="mt-2 flex justify-center border-t border-(--btn-regular-bg) pt-2">
        <button
          id="mood-reset-btn"
          class="flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-sm text-neutral-900 dark:text-neutral-100 transition hover:bg-(--btn-regular-bg) active:scale-90 cursor-pointer"
        >
          <Icon name="fa7-solid:arrow-rotate-left" is:inline class="text-[0.875rem] text-neutral-900 dark:text-neutral-100" />
          重置
        </button>
      </div>

      <!-- ═══ 底部提示 ═══ -->
      <p class="mt-2 text-center text-[0.6rem] text-neutral-400 dark:text-neutral-500">选完心情后记得刷新一下哦</p>
    </div>
  </div>
</div>

<script data-astro-rerun>
  (function () {
    var STORAGE_KEY = "mood-picker-selection";
    var USER_KEY = "mood-active-user";
    var defaultIcon = "fa7-brands:gratipay";
    var API = "/api/mood";
    var moodLabels = {
      "fa7-regular:face-grin-beam": "愉悦",
      "fa7-regular:face-smile-beam": "悠闲",
      "fa7-regular:face-laugh-squint": "期待",
      "fa7-regular:face-laugh-beam": "自由",
      "fa7-regular:face-frown": "悲伤",
      "fa7-regular:face-meh-blank": "孤独",
      "fa7-regular:face-grimace": "愤怒",
      "fa7-regular:face-frown-open": "遗憾",
      "fa7-regular:face-meh": "无聊",
      "fa7-regular:face-rolling-eyes": "空虚",
      "fa7-regular:face-grin-stars": "发癫",
      "fa7-regular:face-grin-hearts": "想你",
    };

    function initMoodPicker() {
      var btn = document.getElementById("mood-picker-btn");
      var panel = document.getElementById("mood-picker-panel");
      var setupEl = document.getElementById("mood-setup");
      var mainEl = document.getElementById("mood-main");
      var iconElems = document.querySelectorAll("#mood-picker .mood-icon-elem");
      if (!btn || !panel || !setupEl || !mainEl || !iconElems.length) return;

      /* ── 读取已绑定的身份（若无则为 null） ── */
      var activeUser = localStorage.getItem(USER_KEY);

      function showIcon(iconKey) {
        iconElems.forEach(function (el) {
          if (el.getAttribute("data-mood-key") === iconKey) {
            el.classList.remove("hidden");
          } else {
            el.classList.add("hidden");
          }
        });
      }

      function fetchMoods() {
        var xhr = new XMLHttpRequest();
        xhr.open("GET", API, true);
        xhr.onload = function () {
          if (xhr.status === 200) {
            var data = JSON.parse(xhr.responseText);
            refreshStatus(data);
          }
        };
        xhr.send();
      }

      function refreshStatus(data) {
        var mineKey = activeUser;
        var theirsKey = activeUser === "mouhe" ? "yiliu" : "mouhe";
        updateMoodDisplay("mine", data[mineKey]);
        updateMoodDisplay("theirs", data[theirsKey]);
      }

      function updateMoodDisplay(which, iconKey) {
        var defaultEl = document.getElementById("mood-" + which + "-default");
        var labelEl = document.getElementById("mood-" + which + "-label");
        if (!defaultEl || !labelEl) return;
        // 隐藏所有图标
        document.querySelectorAll(".mood-" + which + "-icon").forEach(function (el) {
          el.classList.add("hidden");
        });
        if (iconKey && moodLabels[iconKey]) {
          // 显示对应的图标
          var iconEl = document.querySelector(".mood-" + which + "-icon[data-mood-icon=\"" + iconKey + "\"]");
          if (iconEl) iconEl.classList.remove("hidden");
          defaultEl.classList.add("hidden");
          labelEl.textContent = moodLabels[iconKey];
        } else {
          defaultEl.classList.remove("hidden");
          labelEl.textContent = "未设置";
        }
      }

      function saveMood(user, iconKey) {
        var xhr = new XMLHttpRequest();
        xhr.open("POST", API, true);
        xhr.setRequestHeader("Content-Type", "application/json");
        xhr.onload = function () {
          if (xhr.status === 200) fetchMoods();
        };
        xhr.send(JSON.stringify({ user: user, mood: iconKey }));
      }

      /* ── 切换面板显示模式（设置 / 正式） ── */
      function enterSetupMode() {
        setupEl.classList.remove("hidden");
        mainEl.classList.add("hidden");
      }
      function enterMainMode() {
        setupEl.classList.add("hidden");
        mainEl.classList.remove("hidden");
      }

      /* ── 绑定身份 ── */
      function bindUser(user) {
        activeUser = user;
        localStorage.setItem(USER_KEY, user);
        enterMainMode();
        // 恢复之前保存的心情图标
        var saved = localStorage.getItem(STORAGE_KEY);
        if (saved) showIcon(saved);
        fetchMoods();
      }

      /* ── 首次打开时判断是否已绑定 ── */
      if (activeUser) {
        enterMainMode();
        var saved = localStorage.getItem(STORAGE_KEY);
        if (saved) showIcon(saved);
        fetchMoods();
      } else {
        enterSetupMode();
      }

      /* ── 面板切换（捕获阶段监听，避免 Swup 干扰） ── */
      btn.addEventListener("click", function (e) {
        e.stopPropagation();
        panel.classList.toggle("float-panel-closed");
        if (!panel.classList.contains("float-panel-closed")) {
          if (activeUser) fetchMoods();
        }
      }, true);

      /* ── 身份选择按钮 ── */
      document.getElementById("setup-mh").addEventListener("click", function (e) {
        e.stopPropagation();
        bindUser("mouhe");
      }, true);
      document.getElementById("setup-hyl").addEventListener("click", function (e) {
        e.stopPropagation();
        bindUser("yiliu");
      }, true);

      /* ── 选择心情（只允许修改自己的） ── */
      document.querySelectorAll("#mood-picker .mood-option").forEach(function (el) {
        el.addEventListener("click", function (e) {
          e.stopPropagation();
          if (!activeUser) return;
          var icon = el.getAttribute("data-mood-icon");
          if (icon) {
            showIcon(icon);
            localStorage.setItem(STORAGE_KEY, icon);
            saveMood(activeUser, icon);
            panel.classList.add("float-panel-closed");
          }
        }, true);
      });

      /* ── 重置 ── */
      var resetBtn = document.getElementById("mood-reset-btn");
      if (resetBtn) {
        resetBtn.addEventListener("click", function (e) {
          e.stopPropagation();
          if (!activeUser) return;
          showIcon(defaultIcon);
          localStorage.removeItem(STORAGE_KEY);
          saveMood(activeUser, "");
          panel.classList.add("float-panel-closed");
        }, true);
      }

      /* ── 点击外部关闭 ── */
      document.addEventListener("click", function (e) {
        if (!panel.classList.contains("float-panel-closed")) {
          if (
            e.target instanceof Node &&
            !panel.contains(e.target) &&
            !btn.contains(e.target)
          ) {
            panel.classList.add("float-panel-closed");
          }
        }
      }, true);
    }

    // DOM 就绪后初始化
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initMoodPicker);
    } else {
      initMoodPicker();
    }
  })();
</script>
