---
import { Icon } from "astro-icon/components";

// 12 个心情选项
const moods = [
  { icon: "fa7-regular:face-grin-beam", label: "愉悦" },
  { icon: "fa7-regular:face-smile-beam", label: "悠闲" },
  { icon: "fa7-regular:face-laugh-squint", label: "期待" },
  { icon: "fa7-regular:face-laugh-beam", label: "自由" },
  { icon: "fa7-regular:face-frown", label: "悲伤" },
  { icon: "fa7-regular:face-meh-blank", label: "孤独" },
  { icon: "fa7-regular:face-grimace", label: "愤怒" },
  { icon: "fa7-regular:face-frown-open", label: "遗憾" },
  { icon: "fa7-regular:face-meh", label: "无聊" },
  { icon: "fa7-regular:face-rolling-eyes", label: "空虚" },
  { icon: "fa7-regular:face-grin-stars", label: "发癫" },
];

const defaultIcon = "fa7-brands:gratipay";

// 传给 JS 用的心情标签映射
const moodLabelsJson = JSON.stringify(
  moods.reduce((acc, m) => { acc[m.icon] = m.label; return acc; }, {})
);
---

<div id="mood-picker" class="relative inline-flex">
  <button
    id="mood-picker-btn"
    class="btn-plain scale-animation rounded-lg h-11 w-11 active:scale-90 cursor-pointer"
    aria-label="选择心情"
    title="选择心情"
  >
    <Icon
      name={defaultIcon}
      is:inline
      class="mood-icon-elem text-[1.25rem]"
      data-mood-key="fa7-brands:gratipay"
    />
    {moods.map((mood) => (
      <Icon
        name={mood.icon}
        is:inline
        class="mood-icon-elem hidden text-[1.25rem]"
        data-mood-key={mood.icon}
      />
    ))}
  </button>

  <div
    id="mood-picker-panel"
    class="float-panel float-panel-closed absolute top-full mt-2 p-3 z-50
           w-72 max-sm:w-64
           max-sm:left-1/2 max-sm:-translate-x-1/2 max-sm:right-auto
           sm:right-0"
  >
    <!-- ═══ 两人心情状态 ═══ -->
    <div id="mood-status" class="mb-3">
      <div class="flex items-center justify-center gap-3 text-sm">
        <span class="text-xs text-neutral-500 dark:text-neutral-400">我的心情</span>
        <span id="mood-mine-icon" class="text-[1.1rem]">—</span>
        <span id="mood-mine-label" class="text-[0.65rem] text-neutral-500 dark:text-neutral-400">未设置</span>
      </div>
      <div class="flex items-center justify-center gap-3 text-sm mt-1">
        <span class="text-xs text-neutral-500 dark:text-neutral-400">对方的心情</span>
        <span id="mood-theirs-icon" class="text-[1.1rem]">—</span>
        <span id="mood-theirs-label" class="text-[0.65rem] text-neutral-500 dark:text-neutral-400">未设置</span>
      </div>
    </div>

    <!-- ═══ 用户切换 + 刷新 ═══ -->
    <div class="mb-2 flex items-center justify-between border-t border-(--btn-regular-bg) pt-2">
      <div class="flex gap-1">
        <button id="user-toggle-mh" data-user="mouhe"
          class="user-toggle-btn rounded-lg px-2.5 py-1 text-xs transition bg-(--btn-regular-bg) font-semibold"
        >MH</button>
        <button id="user-toggle-hyl" data-user="yiliu"
          class="user-toggle-btn rounded-lg px-2.5 py-1 text-xs transition text-neutral-500 dark:text-neutral-400"
        >HYL</button>
      </div>
      <button id="mood-refresh-btn"
        class="flex items-center gap-1 rounded-lg px-2 py-1 text-xs text-neutral-500 dark:text-neutral-400 transition hover:bg-(--btn-regular-bg) cursor-pointer"
        title="刷新心情"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
      </button>
    </div>

    <!-- ═══ 心情选择网格 ═══ -->
    <div class="grid grid-cols-3 gap-1.5">
      {moods.map((mood) => (
        <button
          data-mood-icon={mood.icon}
          data-mood-label={mood.label}
          class="mood-option flex flex-col items-center justify-center gap-0.5 rounded-lg py-2 px-1 transition hover:bg-(--btn-regular-bg) active:scale-90 cursor-pointer"
        >
          <Icon name={mood.icon} is:inline class="text-[1.375rem] text-neutral-900 dark:text-neutral-100" />
          <span class="text-[0.7rem] leading-tight text-neutral-900 dark:text-neutral-100 whitespace-nowrap">{mood.label}</span>
        </button>
      ))}
    </div>
    <div class="mt-2 flex justify-center border-t border-(--btn-regular-bg) pt-2">
      <button
        id="mood-reset-btn"
        class="flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-sm text-neutral-900 dark:text-neutral-100 transition hover:bg-(--btn-regular-bg) active:scale-90 cursor-pointer"
      >
        <Icon name="fa7-solid:arrow-rotate-left" is:inline class="text-[0.875rem] text-neutral-900 dark:text-neutral-100" />
        重置
      </button>
    </div>
  </div>
</div>

<script data-astro-rerun>
  (function () {
    var STORAGE_KEY = "mood-picker-selection";
    var USER_KEY = "mood-active-user";
    var defaultIcon = "fa7-brands:gratipay";
    var API = "/api/mood";
    var moodLabels = {moodLabelsJson};

    function initMoodPicker() {
      var btn = document.getElementById("mood-picker-btn");
      var panel = document.getElementById("mood-picker-panel");
      var iconElems = document.querySelectorAll("#mood-picker .mood-icon-elem");
      if (!btn || !panel || !iconElems.length) return;

      var activeUser = localStorage.getItem(USER_KEY) || "mouhe";

      function showIcon(iconKey) {
        iconElems.forEach(function (el) {
          if (el.getAttribute("data-mood-key") === iconKey) {
            el.classList.remove("hidden");
          } else {
            el.classList.add("hidden");
          }
        });
      }

      function fetchMoods() {
        var xhr = new XMLHttpRequest();
        xhr.open("GET", API, true);
        xhr.onload = function () {
          if (xhr.status === 200) {
            var data = JSON.parse(xhr.responseText);
            refreshStatus(data);
          }
        };
        xhr.send();
      }

      function refreshStatus(data) {
        var mineKey = activeUser;
        var theirsKey = activeUser === "mouhe" ? "yiliu" : "mouhe";
        updateMoodDisplay("mine", data[mineKey]);
        updateMoodDisplay("theirs", data[theirsKey]);
      }

      function updateMoodDisplay(which, iconKey) {
        var iconEl = document.getElementById("mood-" + which + "-icon");
        var labelEl = document.getElementById("mood-" + which + "-label");
        if (!iconEl || !labelEl) return;
        if (iconKey && moodLabels[iconKey]) {
          iconEl.textContent = moodToEmoji(iconKey);
          labelEl.textContent = moodLabels[iconKey];
        } else {
          iconEl.textContent = "—";
          labelEl.textContent = "未设置";
        }
      }

      function moodToEmoji(iconKey) {
        var map = {
          "fa7-regular:face-grin-beam": "😁",
          "fa7-regular:face-smile-beam": "😊",
          "fa7-regular:face-laugh-squint": "😆",
          "fa7-regular:face-laugh-beam": "😄",
          "fa7-regular:face-frown": "😢",
          "fa7-regular:face-meh-blank": "😶",
          "fa7-regular:face-grimace": "😬",
          "fa7-regular:face-frown-open": "😟",
          "fa7-regular:face-meh": "😐",
          "fa7-regular:face-rolling-eyes": "🙄",
          "fa7-regular:face-grin-stars": "🤩",
        };
        return map[iconKey] || "❤️";
      }

      function saveMood(user, iconKey) {
        var xhr = new XMLHttpRequest();
        xhr.open("POST", API, true);
        xhr.setRequestHeader("Content-Type", "application/json");
        xhr.onload = function () {
          if (xhr.status === 200) fetchMoods();
        };
        xhr.send(JSON.stringify({ user: user, mood: iconKey }));
      }

      function updateUserToggle(user) {
        document.querySelectorAll(".user-toggle-btn").forEach(function (el) {
          var u = el.getAttribute("data-user");
          if (u === user) {
            el.classList.add("bg-(--btn-regular-bg)", "font-semibold");
            el.classList.remove("text-neutral-500", "dark:text-neutral-400");
          } else {
            el.classList.remove("bg-(--btn-regular-bg)", "font-semibold");
            el.classList.add("text-neutral-500", "dark:text-neutral-400");
          }
        });
      }

      // ── 初始化状态 ──
      var saved = localStorage.getItem(STORAGE_KEY);
      if (saved) showIcon(saved);
      updateUserToggle(activeUser);
      fetchMoods();

      // ── 面板切换（捕获阶段监听，避免 Swup 干扰） ──
      btn.addEventListener("click", function (e) {
        e.stopPropagation();
        panel.classList.toggle("float-panel-closed");
        if (!panel.classList.contains("float-panel-closed")) {
          fetchMoods();
        }
      }, true);

      // ── 用户切换 ──
      document.querySelectorAll(".user-toggle-btn").forEach(function (el) {
        el.addEventListener("click", function (e) {
          e.stopPropagation();
          var user = el.getAttribute("data-user");
          activeUser = user;
          localStorage.setItem(USER_KEY, user);
          updateUserToggle(user);
          fetchMoods();
        }, true);
      });

      // ── 选择心情 ──
      document.querySelectorAll("#mood-picker .mood-option").forEach(function (el) {
        el.addEventListener("click", function (e) {
          e.stopPropagation();
          var icon = el.getAttribute("data-mood-icon");
          if (icon) {
            showIcon(icon);
            localStorage.setItem(STORAGE_KEY, icon);
            saveMood(activeUser, icon);
            panel.classList.add("float-panel-closed");
          }
        }, true);
      });

      // ── 重置 ──
      var resetBtn = document.getElementById("mood-reset-btn");
      if (resetBtn) {
        resetBtn.addEventListener("click", function (e) {
          e.stopPropagation();
          showIcon(defaultIcon);
          localStorage.removeItem(STORAGE_KEY);
          saveMood(activeUser, "");
          panel.classList.add("float-panel-closed");
        }, true);
      }

      // ── 刷新按钮 ──
      var refreshBtn = document.getElementById("mood-refresh-btn");
      if (refreshBtn) {
        refreshBtn.addEventListener("click", function (e) {
          e.stopPropagation();
          fetchMoods();
        }, true);
      }

      // ── 点击外部关闭 ──
      document.addEventListener("click", function (e) {
        if (!panel.classList.contains("float-panel-closed")) {
          if (
            e.target instanceof Node &&
            !panel.contains(e.target) &&
            !btn.contains(e.target)
          ) {
            panel.classList.add("float-panel-closed");
          }
        }
      }, true);
    }

    // DOM 就绪后初始化
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initMoodPicker);
    } else {
      initMoodPicker();
    }
  })();
</script>
