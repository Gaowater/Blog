---
import { Icon } from "astro-icon/components";
import { url } from "@/utils/url-utils";

// 底部导航项
const navItems = [
  { href: "/", icon: "material-symbols:home", label: "首页" },
  { href: "/gallery/", icon: "material-symbols:photo-album", label: "相册" },
  { href: "/collections/", icon: "material-symbols:movie", label: "驻足" },
  { href: "#calendar-section", icon: "material-symbols:calendar-month", label: "日历", scroll: true },
  { href: "/about/", icon: "material-symbols:info", label: "关于" },
];
---

<!-- 手机端底部导航（仅在 <768px 显示） -->
<nav id="mobile-bottom-nav" class="mobile-bottom-nav">
  <div class="flex items-center justify-around h-full max-w-lg mx-auto px-2">
    {navItems.map((item) => (
      item.scroll ? (
        <button
          data-scroll-id={item.href.replace('#', '')}
          class="mobile-nav-item flex flex-col items-center justify-center gap-0.5 px-3 py-1 rounded-lg transition-colors duration-150 text-neutral-400 dark:text-neutral-500 bg-transparent border-none cursor-pointer"
        >
          <Icon name={item.icon} class="text-xl" />
          <span class="text-[10px] leading-none font-medium">{item.label}</span>
        </button>
      ) : (
        <a
          href={url(item.href)}
          class="mobile-nav-item flex flex-col items-center justify-center gap-0.5 px-3 py-1 rounded-lg transition-colors duration-150 text-neutral-400 dark:text-neutral-500 no-underline"
        >
          <Icon name={item.icon} class="text-xl" />
          <span class="text-[10px] leading-none font-medium">{item.label}</span>
        </a>
      )
    ))}
  </div>
</nav>

<script is:inline>
  (function() {
    var primaryColor = '';
    function getPrimary() {
      if (!primaryColor) {
        primaryColor = getComputedStyle(document.documentElement).getPropertyValue('--primary').trim();
      }
      return primaryColor;
    }

    // 给某个导航项上色（视觉反馈）
    function paintNavItem(item) {
      var color = getPrimary();
      item.style.color = color;
      item.style.transition = 'color 0s'; // 瞬间变色，不等过渡
    }

    // 清除所有导航项的高亮
    function clearAllNav() {
      document.querySelectorAll('.mobile-nav-item').forEach(function(item) {
        item.style.color = '';
        item.style.transition = '';
      });
    }

    // 更新导航高亮（匹配当前路由）
    function updateActiveNav() {
      var currentPath = window.location.pathname;
      var items = document.querySelectorAll('.mobile-nav-item');

      clearAllNav();

      items.forEach(function(item) {
        var href = item.getAttribute('href');

        // 日历按钮：通过 IntersectionObserver 单独控制，此处跳过
        if (!href) return;

        var isActive = false;
        if (href === '/') {
          isActive = currentPath === '/' || currentPath === '';
        } else {
          isActive = href !== '#' && currentPath.startsWith(href);
        }

        if (isActive) {
          item.style.color = getPrimary();
          item.style.transition = '';
        }
      });
    }

    // 检测日历 section 是否可见（控制日历图标高亮）
    var calendarObserver;
    function watchCalendarSection() {
      var section = document.getElementById('calendar-section');
      var calBtn = document.querySelector('.mobile-nav-item[data-scroll-id="calendar-section"]');
      if (!section || !calBtn) return;

      if (calendarObserver) calendarObserver.disconnect();

      calendarObserver = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            calBtn.style.color = getPrimary();
            calBtn.style.transition = '';
          } else {
            // 只在非点击状态下移除高亮（防止点击后闪烁移除）
            if (!calBtn._clicked) {
              calBtn.style.color = '';
              calBtn.style.transition = '';
            }
          }
        });
      }, { threshold: 0.15 });

      calendarObserver.observe(section);
    }

    // 日历居中滚动
    function scrollToCalendar() {
      var target = document.getElementById('calendar-section');
      if (!target) return;

      var targetTop = target.getBoundingClientRect().top + window.scrollY;
      var viewH = window.innerHeight;
      var targetH = target.offsetHeight;
      var scrollTo = targetTop - (viewH - targetH) / 2 - viewH * 0.08;
      window.scrollTo({ top: Math.max(0, scrollTo), behavior: 'smooth' });
    }

    // ─── 统一点击处理：先变色，再跳转 ───
    document.addEventListener('click', function(e) {
      var item = e.target.closest('.mobile-nav-item');
      if (!item) return;

      // 1. 先上色（瞬间显示反馈）
      paintNavItem(item);
      item._clicked = true;

      // 2. 清除其他项的 _clicked 标记
      document.querySelectorAll('.mobile-nav-item').forEach(function(other) {
        if (other !== item) other._clicked = false;
      });

      // 3. 处理日历按钮
      var scrollId = item.getAttribute('data-scroll-id');
      if (scrollId) {
        e.preventDefault();

        var target = document.getElementById(scrollId);
        if (!target) {
          // 不在首页 → 标记后跳转
          sessionStorage.setItem('scrollToCalendar', 'true');
          window.location.href = '/';
          return;
        }

        // 在首页 → 延迟一下让颜色能显示，再滚动
        setTimeout(function() {
          scrollToCalendar();
          // 滚动后保持高亮一小段时间
          setTimeout(function() {
            item._clicked = false;
          }, 1000);
        }, 100);
        return;
      }

      // 4. 处理普通链接：延迟跳转让颜色显示
      var href = item.getAttribute('href');
      if (href && !href.startsWith('#') && !href.startsWith('javascript:')) {
        e.preventDefault();
        var targetUrl = href;
        // 如果是相对路径，用 Swup 或者直接跳转
        setTimeout(function() {
          item._clicked = false;
          window.location.href = targetUrl;
        }, 120);
      }
    });

    // ─── 初始化 ───
    updateActiveNav();
    watchCalendarSection();

    // 跨页跳转后恢复日历标记
    if (sessionStorage.getItem('scrollToCalendar') === 'true') {
      sessionStorage.removeItem('scrollToCalendar');
      setTimeout(scrollToCalendar, 200);
      // 给日历按钮上色
      var calBtn = document.querySelector('.mobile-nav-item[data-scroll-id="calendar-section"]');
      if (calBtn) {
        setTimeout(function() {
          calBtn.style.color = getPrimary();
          calBtn.style.transition = '';
        }, 100);
      }
    }

    // Swup 页面切换后重新初始化
    document.addEventListener('swup:contentReplaced', function() {
      setTimeout(function() {
        updateActiveNav();
        watchCalendarSection();
        // 检查滚动标记
        if (sessionStorage.getItem('scrollToCalendar') === 'true') {
          sessionStorage.removeItem('scrollToCalendar');
          setTimeout(scrollToCalendar, 200);
        }
      }, 50);
    });
  })();
</script>

<style is:global>
  .mobile-bottom-nav {
    display: none;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    height: 56px;
    background: color-mix(in oklab, var(--card-bg) 92%, transparent);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-top: 1px solid var(--line-color);
    z-index: 1000;
    padding-bottom: env(safe-area-inset-bottom, 0);
  }

  @media (max-width: 767px) {
    .mobile-bottom-nav {
      display: block;
    }
    /* 页面底部留出空间，不被导航挡住 */
    body {
      padding-bottom: 64px;
    }
  }
</style>
