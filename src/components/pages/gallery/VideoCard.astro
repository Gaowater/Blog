---
interface Props {
	src: string;
	albumId: string;
	index: number;
}

const { src, albumId, index } = Astro.props;
const videoId = `video-${albumId}-${index}`;
---

<div
  class="video-card rounded-xl overflow-hidden bg-neutral-900 relative group cursor-pointer aspect-video"
  data-video-id={videoId}
>
  <!-- 占位封面：点击前只显示播放按钮，不加载视频 -->
  <div class="video-placeholder w-full h-full flex items-center justify-center text-white/60 select-none">
    <div class="flex flex-col items-center gap-2">
      <svg width="48" height="48" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="24" cy="24" r="20" />
        <polygon points="20,15 20,33 34,24" fill="currentColor" stroke="none" />
      </svg>
      <span class="text-xs text-white/40">点击播放</span>
    </div>
  </div>
  <!-- 视频元素（初始不加载） -->
  <video
    controls
    preload="none"
    playsinline
    class="hidden w-full h-full absolute inset-0 object-contain bg-black rounded-xl"
  >
    <source src={src} type="video/mp4" />
  </video>
</div>

<script is:inline>
  (function() {
    // 用 data 属性查找，避免 Astro 模板变量问题
    var cards = document.querySelectorAll('[data-video-id]');
    cards.forEach(function(card) {
      var placeholder = card.querySelector('.video-placeholder');
      var video = card.querySelector('video');

      function playVideo() {
        if (!video || !placeholder) return;
        placeholder.style.display = 'none';
        video.classList.remove('hidden');
        video.load();
        video.play().catch(function() {});
        card.removeEventListener('click', playVideo);
      }

      card.addEventListener('click', playVideo);
    });
  })();
</script>
