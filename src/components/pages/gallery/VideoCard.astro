---
interface Props {
	src: string;
	albumId: string;
	index: number;
}

const { src, albumId, index } = Astro.props;
const videoId = `video-${albumId}-${index}`;
const posterSrc = src.replace(/\/[^/]+$/, "/cover.jpg");
---

<div
  class="video-card rounded-xl overflow-hidden bg-black relative group cursor-pointer aspect-[9/16]"
  data-video-id={videoId}
>
  <!-- 视频：使用 cover.jpg 作为海报封面，点击前不加载视频数据 -->
  <video
    preload="none"
    poster={posterSrc}
    playsinline
    muted
    class="w-full h-full object-cover rounded-xl"
  >
    <source src={src} type="video/mp4" />
  </video>

  <!-- 播放按钮覆盖层 -->
  <div class="video-placeholder absolute inset-0 flex items-center justify-center bg-black/20 hover:bg-black/10 transition-colors duration-200 z-10">
    <div class="flex flex-col items-center gap-2">
      <div class="w-14 h-14 rounded-full bg-black/60 backdrop-blur-sm flex items-center justify-center transition-transform duration-200 group-hover:scale-110">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="white">
          <polygon points="8,5 8,19 19,12" />
        </svg>
      </div>
      <span class="text-xs text-white/70">点击播放</span>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    var cards = document.querySelectorAll('[data-video-id]');
    cards.forEach(function(card) {
      var placeholder = card.querySelector('.video-placeholder');
      var video = card.querySelector('video');
      var preloaded = false;

      function startPreload() {
        if (preloaded || !video) return;
        preloaded = true;
        video.preload = 'auto';
        video.load();
      }

      // 滚动到可见区域时开始预加载（移动端也生效）
      if ('IntersectionObserver' in window) {
        var observer = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              startPreload();
              observer.unobserve(entry.target);
            }
          });
        }, { rootMargin: '200px' }); // 距离可见区域 200px 就开始加载
        observer.observe(card);
      }

      // 鼠标悬停时也触发预加载（桌面端）
      card.addEventListener('mouseenter', startPreload);

      function playVideo() {
        if (!video || !placeholder) return;
        placeholder.style.display = 'none';
        video.muted = false;
        video.setAttribute('controls', '');
        if (!preloaded) {
          preloaded = true;
          video.preload = 'auto';
          video.load();
        }
        video.play().catch(function() {});
      }

      card.addEventListener('click', playVideo);
    });
  })();
</script>
