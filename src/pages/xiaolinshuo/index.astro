---
import { render } from "astro:content";
import { Icon } from "astro-icon/components";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import {
	formatXiaoDate,
	getXiaoEntries,
	getXiaoUrl,
} from "@/utils/xiaolinshuo-utils";

const entries = await getXiaoEntries();

const items = await Promise.all(
	entries.map(async (entry, index) => {
		const { remarkPluginFrontmatter } = await render(entry);
		const fm = remarkPluginFrontmatter as {
			excerpt?: string;
			words?: number;
			minutes?: number;
		};
		return {
			key: entry.id,
			index,
			url: getXiaoUrl(entry),
			title: entry.data.title,
			cover: entry.data.cover,
			dek: entry.data.description || fm.excerpt || "",
			published: formatXiaoDate(entry.data.published),
			words: Number(fm.words ?? 0),
			minutes: Number(fm.minutes ?? 0),
		};
	}),
);

const featured = items[0];
const rest = items.slice(1);
const latestDate = featured?.published ?? "";
---

<MainGridLayout
  title="小琳说"
  description="小琳写下的东西，信也好，日记也好，都收在这里。"
>
  <div class="card-base xl-wrap">
    <!-- 栏目标识 -->
    <header class="xl-head onload-animation">
      <div class="xl-mark">手记</div>
      <h1>小琳说</h1>
      <p class="xl-sub">她写下的东西，我一篇一篇收着。</p>
      <div class="xl-count">
        共 {items.length} 篇{latestDate && ` · 最近更新 ${latestDate}`}
      </div>
    </header>

    <div class="xl-rule"></div>

    {
      featured && (
        <a
          class="xl-featured onload-animation"
          href={featured.url}
          style="animation-delay: calc(var(--content-delay) + 60ms);"
        >
          {featured.cover && (
            <div class="xl-featured-thumb">
              <img src={featured.cover} alt={featured.title} loading="eager" />
            </div>
          )}
          <div class="xl-featured-info">
            <span class="xl-badge">最新</span>
            <h2>{featured.title}</h2>
            {featured.dek && <p>{featured.dek}</p>}
            <div class="xl-meta">
              <span>{featured.published}</span>
              {featured.words > 0 && <span>{featured.words} 字</span>}
              {featured.minutes > 0 && <span>约 {featured.minutes} 分钟</span>}
            </div>
          </div>
        </a>
      )
    }

    {
      rest.length > 0 && (
        <div class="xl-list">
          {rest.map((item, i) => (
            <a
              class="xl-card onload-animation"
              href={item.url}
              style={`animation-delay: calc(var(--content-delay) + ${120 + i * 50}ms);`}
            >
              <span class="xl-num">
                {String(item.index + 1).padStart(2, "0")}
              </span>
              <div class="xl-card-body">
                <h3>{item.title}</h3>
                {item.dek && <p>{item.dek}</p>}
                <div class="xl-meta">
                  <span>{item.published}</span>
                  {item.words > 0 && <span>{item.words} 字</span>}
                </div>
              </div>
              {item.cover && (
                <div class="xl-thumb">
                  <img src={item.cover} alt={item.title} loading="lazy" />
                </div>
              )}
            </a>
          ))}
        </div>
      )
    }

    {
      items.length === 0 && (
        <div class="xl-empty">
          <Icon name="material-symbols:edit-note" class="text-2xl" />
          <p>这个栏目还空着。</p>
        </div>
      )
    }
  </div>
</MainGridLayout>

<style is:global>
  /* 本页不出现全站分类栏：靠 .xl-wrap 判定，纯 CSS 无闪烁 */
  body:has(.xl-wrap) #category-bar-wrapper,
  body:has(.xl-article) #category-bar-wrapper {
    display: none;
  }

  .xl-wrap {
    --xl-serif: "Songti SC", "Source Han Serif SC", "Noto Serif SC",
      "STSong", "SimSun", serif;
    overflow: hidden;
  }

  /* ── 栏目标识 ── */
  .xl-head {
    padding: 2.4rem 2.6rem 1.25rem;
  }
  .xl-mark {
    font-size: 0.7rem;
    letter-spacing: 0.34em;
    color: var(--primary);
    text-indent: 0.34em;
  }
  .xl-head h1 {
    font-family: var(--xl-serif);
    font-size: clamp(1.7rem, 2.6vw, 2.2rem);
    font-weight: 500;
    letter-spacing: 0.08em;
    margin: 0.7rem 0 0.55rem;
    color: var(--deep-text);
  }
  .xl-sub {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.9;
    color: var(--content-meta);
  }
  .xl-count {
    margin-top: 1.05rem;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    color: var(--content-meta);
    opacity: 0.85;
  }
  .xl-rule {
    height: 1px;
    margin: 0 2.6rem;
    background: linear-gradient(90deg, var(--line-color), transparent);
  }

  /* ── 首篇大卡 ── */
  .xl-featured {
    display: flex;
    gap: 1.75rem;
    margin: 1.7rem 1.7rem 0;
    padding: 1.4rem 1.5rem;
    border-radius: var(--radius-large);
    border: 1px solid var(--line-divider);
    background: var(--btn-plain-bg-hover);
    text-decoration: none;
    color: inherit;
    transition:
      border-color 0.25s ease,
      transform 0.25s ease;
  }
  .xl-featured:hover {
    border-color: color-mix(in oklab, var(--primary) 45%, transparent);
    transform: translateY(-2px);
  }
  .xl-featured-thumb {
    width: 42%;
    flex: none;
    aspect-ratio: 4 / 3;
    border-radius: 0.8rem;
    overflow: hidden;
    border: 1px solid var(--line-divider);
  }
  .xl-featured-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .xl-featured-info {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
  }
  .xl-badge {
    align-self: flex-start;
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    color: var(--primary);
    border: 1px solid color-mix(in oklab, var(--primary) 35%, transparent);
    border-radius: 999px;
    padding: 0.15rem 0.6rem 0.15rem 0.72rem;
    margin-bottom: 0.85rem;
  }
  .xl-featured h2 {
    font-family: var(--xl-serif);
    font-size: clamp(1.35rem, 2vw, 1.75rem);
    font-weight: 500;
    line-height: 1.55;
    letter-spacing: 0.02em;
    margin: 0 0 0.6rem;
    color: var(--deep-text);
    transition: color 0.2s ease;
  }
  .xl-featured:hover h2 {
    color: var(--primary);
  }
  /* 只有一篇文章、没有下方列表时，首篇大卡自己承担底部留白，避免贴住卡片边缘 */
  .xl-wrap:not(:has(.xl-list)) .xl-featured {
    margin-bottom: 2.2rem;
  }
  .xl-featured-info p {
    margin: 0 0 0.95rem;
    font-size: 0.88rem;
    line-height: 1.9;
    color: var(--content-meta);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ── 元信息 ── */
  .xl-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--content-meta);
    opacity: 0.9;
  }
  .xl-meta span {
    position: relative;
  }
  .xl-meta span + span::before {
    content: "";
    position: absolute;
    left: -0.55rem;
    top: 50%;
    width: 2px;
    height: 2px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.6;
  }

  /* ── 小卡列表 ── */
  .xl-list {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 0.5rem 2.6rem 2.4rem;
  }
  .xl-card {
    display: flex;
    align-items: flex-start;
    gap: 1.1rem;
    padding: 1.15rem 1.3rem;
    border-radius: 0.9rem;
    background: var(--btn-card-bg-hover);
    text-decoration: none;
    color: inherit;
    transition: background 0.25s ease;
  }
  .xl-card:hover {
    background: var(--btn-plain-bg-hover);
  }
  .xl-num {
    flex: none;
    width: 2.2rem;
    padding-top: 0.1rem;
    font-family: var(--xl-serif);
    font-size: 1.65rem;
    line-height: 1;
    color: color-mix(in oklab, var(--deep-text) 16%, transparent);
    transition: color 0.2s ease;
  }
  .xl-card:hover .xl-num {
    color: var(--primary);
  }
  .xl-card-body {
    min-width: 0;
    flex: 1;
  }
  .xl-card h3 {
    font-size: 1.08rem;
    font-weight: 500;
    line-height: 1.6;
    margin: 0 0 0.4rem;
    color: var(--deep-text);
    transition: color 0.2s ease;
  }
  .xl-card:hover h3 {
    color: var(--primary);
  }
  .xl-card p {
    margin: 0 0 0.6rem;
    font-size: 0.84rem;
    line-height: 1.85;
    color: var(--content-meta);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .xl-thumb {
    width: 96px;
    aspect-ratio: 4 / 3;
    flex: none;
    border-radius: 0.6rem;
    overflow: hidden;
    border: 1px solid var(--line-divider);
  }
  .xl-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .xl-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    padding: 4rem 1rem 5rem;
    color: var(--content-meta);
    font-size: 0.9rem;
  }

  @media (max-width: 767px) {
    .xl-head {
      padding: 1.6rem 1.15rem 1rem;
    }
    .xl-rule {
      margin: 0 1.15rem;
    }
    .xl-featured {
      flex-direction: column-reverse;
      margin: 1.1rem 0.9rem 0;
      padding: 1.1rem;
      gap: 1rem;
    }
    .xl-featured-thumb {
      width: 100%;
    }
    .xl-list {
      padding: 0.4rem 1.15rem 1.6rem;
    }
    .xl-thumb {
      width: 72px;
    }
  }
</style>
