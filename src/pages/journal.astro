        drawRoundRect(ctx, W / 2 - dw / 2, 168, dw, 46, 999);
        ctx.fill();
        ctx.fillStyle = "rgba(124,111,99,0.78)";
        ctx.fillText(dateText, W / 2, 168 + 32);
      }
      const title = sheet?.querySelector(".j-cover-title")?.textContent?.trim() || "\u6211\u7684\u624B\u8D26";
      ctx.font = `400 96px ${FONT}`;
      ctx.fillStyle = "#5f554b";
      ctx.fillText(title, W / 2, 340);
      ctx.save();
      ctx.strokeStyle = "rgba(242,166,181,0.75)";
      ctx.lineWidth = 5;
      ctx.lineCap = "round";
      ctx.beginPath();
      for (let x = W / 2 - 190; x <= W / 2 + 190; x += 10) {
        const y = 388 + Math.sin((x - W / 2 + 190) / 22) * 5;
        if (x === W / 2 - 190) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      }
      ctx.stroke();
      ctx.restore();
      const sub = sheet?.querySelector(".j-cover-subtitle")?.textContent?.trim() || "";
      if (sub) {
        ctx.font = `400 34px ${FONT}`;
        ctx.fillStyle = inkSoft;
        ctx.fillText(sub, W / 2, 460);
      }
      ctx.save();
      ctx.setLineDash([10, 9]);
      ctx.strokeStyle = "rgba(188,221,200,0.85)";
      ctx.lineWidth = 3;
      ctx.beginPath();
      ctx.moveTo(W / 2 - 130, 530);
      ctx.lineTo(W / 2 + 130, 530);
      ctx.stroke();
      ctx.restore();
      const paras = Array.from(sheet?.querySelectorAll(".j-cover-text p") || []).map((p) => p.textContent?.trim() || "").filter(Boolean);
      ctx.font = `400 30px ${FONT}`;
      ctx.fillStyle = inkSoft;
      let py = 590;
      paras.forEach((para) => {
        py += wrapText(ctx, para, W / 2, py, 620, 46, 6) + 10;
      });
      const author = sheet?.querySelector(".j-cover-author")?.textContent?.trim() || "\u2014\u2014 \u7267\u6CB3\u4F0A\u7409";
      ctx.font = `400 30px ${FONT}`;
      ctx.fillStyle = "rgba(124,111,99,0.78)";
      const authorY = Math.max(py + 30, 1050);
      ctx.fillText(author, W / 2, authorY);
      ctx.font = `400 22px ${FONT}`;
      ctx.fillStyle = "rgba(124,111,99,0.45)";
      ctx.fillText("\u6211\u7684\u6570\u5B57\u624B\u8D26 \xB7 \u4E00\u5E74\u4E00\u4F1A", W / 2, authorY + 70);
      return authorY + 110;
    } else if (pageIdx === 1) {
      // ══ 引言页卡片 ══
      const introTitle =
        sheet?.querySelector(".j-intro-title")?.textContent?.trim() || "\u5199\u5728\u524D\u9762";
      const paras = Array.from(sheet?.querySelectorAll(".j-intro-text p") || [])
        .map((p) => p.textContent?.trim() || "")
        .filter(Boolean);
      ctx.font = `400 24px ${FONT}`;
      const badge = "\u5E8F";
      const bw = ctx.measureText(badge).width + 44;
      ctx.fillStyle = "rgba(188,221,200,0.4)";
      drawRoundRect(ctx, W / 2 - bw / 2, 150, bw, 40, 999);
      ctx.fill();
      ctx.fillStyle = "#3f7a5c";
      ctx.fillText(badge, W / 2, 150 + 27);
      ctx.font = `400 52px ${FONT}`;
      ctx.fillStyle = "#5f554b";
      ctx.fillText(introTitle, W / 2, 280);
      ctx.save();
      ctx.strokeStyle = "rgba(242,166,181,0.75)";
      ctx.lineWidth = 4;
      ctx.lineCap = "round";
      ctx.beginPath();
      for (let x = W / 2 - 110; x <= W / 2 + 110; x += 9) {
        const y = 320 + Math.sin((x - W / 2 + 110) / 20) * 4;
        if (x === W / 2 - 110) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      }
      ctx.stroke();
      ctx.restore();
      ctx.font = `400 32px ${FONT}`;
      ctx.fillStyle = "rgba(92,80,64,0.9)";
      let iy = 400;
      paras.forEach((para) => {
        iy += wrapText(ctx, para, W / 2, iy, 640, 54, 10) + 14;
      });
      const introAuthor =
        b.book.querySelector(".j-cover-author")?.textContent?.trim() || "\u2014\u2014 \u7267\u6CB3\u4F0A\u7409";
      ctx.font = `400 30px ${FONT}`;
      ctx.fillStyle = "rgba(124,111,99,0.78)";
      const introAuthorY = Math.max(iy + 20, 1140);
      ctx.fillText(introAuthor, W / 2, introAuthorY);
      return introAuthorY + 40;
    } else {
      ctx.textAlign = "left";
      const dateText = sheet?.querySelector(".j-head-date")?.textContent?.trim() || "\u65E5\u8BB0";
      const moodText = sheet?.querySelector(".j-head-mood")?.textContent?.trim() || "";
      const titleText = sheet?.querySelector(".j-head-title")?.textContent?.trim() || "";
      ctx.font = `400 64px ${FONT}`;
      ctx.fillStyle = ink;
      ctx.fillText(dateText, 70, 150);
      if (moodText) {
        const dateW = ctx.measureText(dateText).width;
        ctx.font = "46px sans-serif";
        ctx.fillText(moodText, 70 + dateW + 26, 148);
      }
      ctx.font = `400 32px ${FONT}`;
      ctx.fillStyle = inkSoft;
      ctx.fillText(titleText, 70, 205);
      ctx.save();
      ctx.setLineDash([10, 9]);
      ctx.strokeStyle = "rgba(188,221,200,0.85)";
      ctx.lineWidth = 3;
