<script is:inline data-astro-rerun>
function initJournal() {
  const yearsEl = document.getElementById("j-years");
  if (!yearsEl || yearsEl.dataset.init === "1") return;
  yearsEl.dataset.init = "1";
  const books = Array.from(yearsEl.querySelectorAll(".j-year-book")).map((el) => ({
    el,
    book: el.querySelector(".j-book"),
    source: el.querySelector(".j-diary-source"),
    sheets: [],
    current: 0,
    ready: false
  })).filter((b) => b.book);
  if (books.length === 0) return;
  const indicator = document.getElementById("j-page-indicator");
  const yearSelect = document.getElementById("j-year-select");
  const paperSelect = document.getElementById("j-paper-select");
  const tocPanel = document.getElementById("j-toc");
  const tocMask = document.getElementById("j-toc-mask");
  const tocBtn = document.getElementById("j-toc-btn");
  const tocClose = document.getElementById("j-toc-close");
  function getCurrentBook() {
    return books.find((b) => b.el.dataset.year === yearSelect.value);
  }
  function injectDiary(b) {
    if (!b.source) return;
    const heads = b.source.querySelectorAll("h2");
    heads.forEach((h) => {
      h.querySelector(".anchor")?.remove();
      const key = h.textContent.trim();
      const target = b.book.querySelector(
        `.j-sheet[data-date="${key}"] .j-diary-slot`
      );
      if (!target) return;
      const nodes = [];
      let n = h.nextElementSibling;
      while (n && n.tagName !== "H2") {
        nodes.push(n);
        n = n.nextElementSibling;
      }
      if (nodes.length === 0) return;
      const wrap = document.createElement("div");
      wrap.className = "j-diary-content";
      nodes.forEach((node) => wrap.appendChild(node.cloneNode(true)));
      target.innerHTML = "";
      target.appendChild(wrap);
      const block = target.closest(".j-diary");
      if (block) block.classList.add("has-content");
    });
  }
  const T = 550;
  function renderBook(b, instant) {
    b.sheets.forEach((s, i) => {
      const dist = i - b.current;
      const abs = Math.abs(dist);
      let tx = 0;
      let ry = 0;
      let sc = 1;
      let op = 1;
      s.dataset.state = dist === 0 ? "active" : abs <= 1 ? "near" : "hidden";
      if (abs > 1) {
        tx = (dist > 0 ? 1 : -1) * (abs - 1) * 30;
        ry = (dist > 0 ? 1 : -1) * 10;
        op = 0;
      } else {
        tx = dist * 18;
        ry = dist * -16;
        sc = 1 - abs * 0.05;
      }
      s.style.transition = instant ? "none" : `transform ${T}ms cubic-bezier(0.22, 1, 0.36, 1), opacity ${T * 0.7}ms ease`;
      s.style.transform = `translateX(${tx}%) translateZ(0) rotateY(${ry}deg) scale(${sc})`;
      s.style.opacity = String(op);
      s.style.zIndex = String(100 - abs);
    });
  }
  function goTo(delta, instant = false) {
    const b = getCurrentBook();
    if (!b || b.sheets.length === 0) return;
    const next = Math.max(0, Math.min(b.sheets.length - 1, b.current + delta));
    if (next === b.current) return;
    b.current = next;
    renderBook(b, instant);
    updateIndicator();
    saveState();
  }
  function updateIndicator() {
    const b = getCurrentBook();
    if (!b) return;
    if (indicator) {
      indicator.textContent = `${b.current + 1} / ${b.sheets.length}`;
    }
  }
  function saveState() {
    const b = getCurrentBook();
    if (!b) return;
    try {
      localStorage.setItem(
        "journal-state",
        JSON.stringify({ year: yearSelect.value, page: b.current })
      );
    } catch (e) {
    }
  }
  const prevBtn = document.getElementById("j-prev");
  const nextBtn = document.getElementById("j-next");
  prevBtn?.addEventListener("click", () => goTo(-1));
  nextBtn?.addEventListener("click", () => goTo(1));
  document.addEventListener("keydown", function(e) {
    if (tocPanel && !tocPanel.hidden) {
      if (e.key === "Escape") closeToc();
      return;
    }
    if (e.key === "ArrowLeft") goTo(-1);
    if (e.key === "ArrowRight") goTo(1);
  });
  function bindTouch(b) {
    let startX = 0;
    let startY = 0;
    let tracking = false;
    b.book.addEventListener(
      "touchstart",
      (e) => {
        const t = e.touches[0];
        startX = t.clientX;
        startY = t.clientY;
        tracking = true;
      },
      { passive: true }
    );
    b.book.addEventListener(
      "touchmove",
      (e) => {
        if (!tracking) return;
        const t = e.touches[0];
        const dx = t.clientX - startX;
        const dy = t.clientY - startY;
        if (Math.abs(dx) > Math.abs(dy) && Math.abs(dx) > 10) {
          e.preventDefault();
        }
      },
      { passive: false }
    );
    b.book.addEventListener(
      "touchend",
      (e) => {
        if (!tracking) return;
        tracking = false;
        if (b.el.hidden) return;
        const t = e.changedTouches[0];
        const dx = t.clientX - startX;
        if (Math.abs(dx) < 55) return;
        const next = Math.max(
          0,
          Math.min(b.sheets.length - 1, b.current + (dx < 0 ? 1 : -1))
        );
        if (next === b.current) return;
        b.current = next;
        renderBook(b);
        updateIndicator();
        saveState();
      },
      { passive: true }
    );
  }
  function prepareBook(b) {
    if (b.ready) return;
    b.sheets = Array.from(b.book.querySelectorAll(".j-sheet"));
    if (b.sheets.length === 0) return;
    injectDiary(b);
    bindTouch(b);
    b.sheets.forEach((s) => {
      s.addEventListener("click", (e) => {
        if (e.target instanceof Element) {
          if (e.target.closest("input, label, a, button, select")) return;
        }
        if (s.dataset.state === "active" || s.dataset.state === "hidden") return;
        const idx = Number(s.dataset.page);
        if (idx < b.current) {
          const next = Math.max(0, b.current - 1);
          if (next !== b.current) {
            b.current = next;
            renderBook(b);
            updateIndicator();
            saveState();
          }
        } else if (idx > b.current) {
          const next = Math.min(b.sheets.length - 1, b.current + 1);
          if (next !== b.current) {
            b.current = next;
            renderBook(b);
            updateIndicator();
            saveState();
          }
        }
      });
    });
    b.book.querySelectorAll(".j-img:not([data-portrait-checked])").forEach((img) => {
      img.dataset.portraitChecked = "1";
      const mark = () => {
        if (img.naturalWidth && img.naturalHeight && img.naturalHeight > img.naturalWidth) {
          img.classList.add("j-img-portrait");
        }
      };
      // 已加载完成 → 立即判断；否则等 load（懒加载图片在整页加载时可能延迟/不触发，
      // 因此下面再用 window load 兜底重查一次）
      if (img.complete && img.naturalWidth > 0) mark();
      else img.addEventListener("load", mark);
    });
    // 兜底：页面全部资源加载完后，重查所有图片（覆盖懒加载未触发/缓存命中先加载的情况）
    const recheck = () => {
      b.book.querySelectorAll(".j-img").forEach((img) => {
        if (img.naturalWidth && img.naturalHeight && img.naturalHeight > img.naturalWidth) {
          img.classList.add("j-img-portrait");
        }
      });
    };
    if (document.readyState === "complete") recheck();
    else window.addEventListener("load", recheck, { once: true });
    b.ready = true;
  }
  function switchYear(year) {
    yearSelect.value = year;
    books.forEach((b) => {
      const show = b.el.dataset.year === year;
      b.el.hidden = !show;
      if (show) {
        prepareBook(b);
        // 每本书优先用该年记忆的纸张，没有则用书自己的（frontmatter paper）
        // 记忆值需为有效纸张（grid 已移除，历史残留直接忽略）
        let mem = null;
        try {
          mem = localStorage.getItem("journal-paper-" + year);
        } catch (e) {
        }
        if (mem !== "lined" && mem !== "blank" && mem !== "kraft") mem = null;
        b.book.dataset.paper = mem || b.book.dataset.paper;
        renderBook(b, true);
        refreshTodoCounts(b.book);
      }
    });
    // 下拉框同步为当前书的纸张，避免显示与实际不符
    const cur = getCurrentBook();
    if (cur && cur.book.dataset.paper) paperSelect.value = cur.book.dataset.paper;
    updateToc(year);
    updateIndicator();
  }
  function updateToc(year) {
    document.querySelectorAll(".j-toc-year").forEach((el) => {
      el.hidden = el.dataset.tocYear !== year;
    });
  }
  function setPaper(paper) {
    paperSelect.value = paper;
    const b = getCurrentBook();
    if (b) b.book.dataset.paper = paper;
    // 按年份记忆纸张，避免全局偏好覆盖其他年份的纸张
    try {
      const y = yearSelect.value;
      if (y) localStorage.setItem("journal-paper-" + y, paper);
    } catch (e) {
    }
  }
  function openToc() {
    if (!tocPanel || !tocMask) return;
    tocPanel.hidden = false;
    tocMask.hidden = false;
    requestAnimationFrame(() => {
      tocPanel.classList.add("open");
      tocMask.classList.add("open");
    });
  }
  function closeToc() {
    if (!tocPanel || !tocMask) return;
    tocPanel.classList.remove("open");
    tocMask.classList.remove("open");
    setTimeout(() => {
      tocPanel.hidden = true;
      tocMask.hidden = true;
    }, 260);
  }
  tocBtn?.addEventListener("click", openToc);
  tocClose?.addEventListener("click", closeToc);
  tocMask?.addEventListener("click", closeToc);
  tocPanel?.addEventListener("click", (e) => {
    const btn = e.target.closest("[data-go]");
    if (!btn) return;
    const year = btn.dataset.year;
    if (year && year !== yearSelect.value) switchYear(year);
    const b = getCurrentBook();
    if (b) {
      b.current = Number(btn.dataset.go);
      renderBook(b);
      updateIndicator();
      saveState();
    }
    closeToc();
  });
  function refreshTodoCounts(bookEl) {
    bookEl.querySelectorAll(".j-sheet").forEach((sheet) => {
      const boxes = sheet.querySelectorAll(".j-todo-label input[type=checkbox]");
      const numEl = sheet.querySelector(".j-todo-num");
      if (!boxes.length || !numEl) return;
      numEl.textContent = String(
        sheet.querySelectorAll(".j-todo-label input:checked").length
      );
    });
  }
  document.addEventListener("change", function(e) {
    const t = e.target;
    if (t && t.matches('.j-todo-label input[type="checkbox"]')) {
      const b = getCurrentBook();
      if (b) refreshTodoCounts(b.book);
    }
  });
  const SELECT_LOCK_MS = 350;
  let yearLockUntil = 0;
  let paperLockUntil = 0;
  yearSelect?.addEventListener("change", () => {
    const now = Date.now();
    if (now < yearLockUntil) return;
    yearLockUntil = now + SELECT_LOCK_MS;
    switchYear(yearSelect.value);
    saveState();
    yearSelect.blur();
  });
  yearSelect?.addEventListener("pointerdown", (e) => {
    if (Date.now() < yearLockUntil) e.preventDefault();
  });
  paperSelect?.addEventListener("change", () => {
    const now = Date.now();
    if (now < paperLockUntil) return;
    paperLockUntil = now + SELECT_LOCK_MS;
    setPaper(paperSelect.value);
    paperSelect.blur();
  });
  paperSelect?.addEventListener("pointerdown", (e) => {
    if (Date.now() < paperLockUntil) e.preventDefault();
  });
  let savedState = null;
  try {
    const raw = localStorage.getItem("journal-state");
    if (raw) savedState = JSON.parse(raw);
  } catch (e) {
  }
  // URL 参数优先（?year=&page=，如从总结页返回时一步到位，服务端已按此渲染）
  const urlYear = new URLSearchParams(location.search).get("year");
  const urlPageRaw = new URLSearchParams(location.search).get("page");
  const urlPage = urlPageRaw !== null ? Number(urlPageRaw) : null;
  const restoreYear =
    (urlYear && books.some((b) => b.el.dataset.year === urlYear) ? urlYear : null) ||
    (savedState?.year && books.some((b) => b.el.dataset.year === savedState.year) ? savedState.year : null) ||
    yearSelect.value;
  switchYear(restoreYear);
  const rb = getCurrentBook();
  const restorePage =
    urlPage !== null && Number.isFinite(urlPage)
      ? urlPage
      : savedState && typeof savedState.page === "number"
        ? savedState.page
        : null;
  if (rb && restorePage !== null) {
    rb.current = Math.max(0, Math.min(rb.sheets.length - 1, restorePage));
    renderBook(rb, true);
    updateIndicator();
  }
  const shareBtn = document.getElementById("j-share-btn");
  const sharePanel = document.getElementById("j-share-panel");
  const shareMask = document.getElementById("j-share-mask");
  const shareImg = document.getElementById("j-share-img");
  const shareLoading = document.getElementById("j-share-loading");
  const shareClose = document.getElementById("j-share-close");
  const shareDownload = document.getElementById("j-share-download");
  let shareDataUrl = "";
  function openShare() {
    if (!sharePanel || !shareMask) return;
    sharePanel.hidden = false;
    shareMask.hidden = false;
    requestAnimationFrame(() => {
      sharePanel.classList.add("open");
      shareMask.classList.add("open");
    });
  }
  function closeShare() {
    if (!sharePanel || !shareMask) return;
    sharePanel.classList.remove("open");
    shareMask.classList.remove("open");
    setTimeout(() => {
      sharePanel.hidden = true;
      shareMask.hidden = true;
    }, 260);
  }
  shareClose?.addEventListener("click", closeShare);
  shareMask?.addEventListener("click", closeShare);
  shareDownload?.addEventListener("click", () => {
    if (!shareDataUrl) return;
    const a = document.createElement("a");
    a.href = shareDataUrl;
    a.download = `journal-card-${Date.now()}.png`;
    a.click();
  });
  function drawRoundRect(ctx, x, y, w, h, r) {
    ctx.beginPath();
    ctx.moveTo(x + r, y);
    ctx.lineTo(x + w - r, y);
    ctx.quadraticCurveTo(x + w, y, x + w, y + r);
    ctx.lineTo(x + w, y + h - r);
    ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);
    ctx.lineTo(x + r, y + h);
    ctx.quadraticCurveTo(x, y + h, x, y + h - r);
    ctx.lineTo(x, y + r);
    ctx.quadraticCurveTo(x, y, x + r, y);
    ctx.closePath();
  }
  function wrapText(ctx, text, x, y, maxWidth, lineHeight, maxLines) {
    const chars = Array.from(text);
    let line = "";
    let drawn = 0;
    for (const ch of chars) {
      if (ctx.measureText(line + ch).width <= maxWidth) {
        line += ch;
      } else {
        ctx.fillText(line, x, y + drawn * lineHeight);
        drawn++;
        if (drawn >= maxLines) return drawn * lineHeight;
        line = ch;
      }
    }
    if (line && drawn < maxLines) {
      ctx.fillText(line, x, y + drawn * lineHeight);
      drawn++;
    }
    return drawn * lineHeight;
  }
  async function drawShareCard(b, pageIdx) {
    const W = 900;
    const sheet = b.book.querySelector(`.j-sheet[data-page="${pageIdx}"]`);
    // 预加载本页所有图片（供测量与绘制共用）
    const imgEls = Array.from(sheet?.querySelectorAll(".j-img") || []);
    const imgs = (
      await Promise.all(
        imgEls.map(
          (el) =>
            new Promise((resolve) => {
              const src = el.getAttribute("src") || "";
              if (!src) return resolve(null);
              const img = new Image();
              img.crossOrigin = "anonymous";
              img.onload = () => resolve(img);
              img.onerror = () => resolve(null);
              img.src = src;
            }),
        ),
      )
    ).filter(Boolean);
    // 渲染一版完整卡片：返回内容底部 y（用于计算总高度）
    function render(ctx, H) {
      const FONT = "'ZCOOL KuaiLe','KaiTi','STKaiti','\u6977\u4F53',cursive";
      const ink = "#5c5040";
    const inkSoft = "rgba(92,80,64,0.62)";
    const pink = "rgba(242,199,208,0.9)";
    const mint = "rgba(188,221,200,0.9)";
    const bg = "#fdf9f1";
    ctx.fillStyle = bg;
    ctx.fillRect(0, 0, W, H);
    const g1 = ctx.createRadialGradient(160, 140, 0, 160, 140, 430);
    g1.addColorStop(0, "rgba(242,199,208,0.32)");
    g1.addColorStop(1, "rgba(242,199,208,0)");
    ctx.fillStyle = g1;
    ctx.fillRect(0, 0, W, H);
    const g2 = ctx.createRadialGradient(W - 160, H - 140, 0, W - 160, H - 140, 430);
    g2.addColorStop(0, "rgba(188,221,200,0.32)");
    g2.addColorStop(1, "rgba(188,221,200,0)");
    ctx.fillStyle = g2;
    ctx.fillRect(0, 0, W, H);
    ctx.save();
    ctx.setLineDash([14, 11]);
    ctx.strokeStyle = "rgba(141,196,162,0.6)";
    ctx.lineWidth = 3;
    drawRoundRect(ctx, 30, 30, W - 60, H - 60, 32);
    ctx.stroke();
    ctx.restore();
    ctx.save();
    ctx.translate(150, 62);
    ctx.rotate(-0.11);
    ctx.fillStyle = mint;
    drawRoundRect(ctx, -95, -22, 190, 44, 6);
    ctx.fill();
    ctx.restore();
    ctx.save();
    ctx.translate(W - 150, 62);
    ctx.rotate(0.1);
    ctx.fillStyle = pink;
    drawRoundRect(ctx, -95, -22, 190, 44, 6);
    ctx.fill();
    ctx.restore();
    ctx.fillStyle = "rgba(242,180,92,0.5)";
    ctx.beginPath();
    ctx.arc(66, 380, 9, 0, Math.PI * 2);
    ctx.fill();
    ctx.fillStyle = "rgba(242,199,208,0.65)";
    ctx.beginPath();
    ctx.arc(W - 66, 520, 12, 0, Math.PI * 2);
    ctx.fill();
    ctx.fillStyle = "rgba(188,221,200,0.7)";
    ctx.beginPath();
    ctx.arc(80, 830, 8, 0, Math.PI * 2);
