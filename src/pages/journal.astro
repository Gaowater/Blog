---
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";
import { getCollection, render } from "astro:content";
import { siteConfig } from "@/config";

// 页面开关：siteConfig.pages.journal 为 false 时返回 404
if (!siteConfig.pages.journal) {
	return Astro.redirect("/404/");
}

// 日期显示：MM.DD
const fmtDay = (date: string) => {
	const m = Number(date.slice(5, 7));
	const dd = Number(date.slice(8, 10));
	return `${m}.${dd.toString().padStart(2, "0")}`;
};

// ── 心情 = 天气拼音 → 图标 ──
// mood 字段支持三种写法：① emoji ② 天气拼音（如 "qing" 晴）③ 完整图标名（如 "material-symbols:wb-sunny"）
// 拼音表：心情 → 天气拼音 → material-symbols 图标
const MOOD_ICONS: Record<string, string> = {
	// 晴
	qing: "material-symbols:wb-sunny", // 晴/开心
	// 多云
	duoyun: "material-symbols:partly-cloudy-day", // 多云/复杂
	// 阴
	yin: "material-symbols:cloud", // 阴/低落
	// 雨
	yu: "material-symbols:rainy", // 雨/悲伤
	xiaoyu: "material-symbols:rainy-light", // 小雨/淡淡忧伤
	dayu: "material-symbols:rainy-heavy", // 大雨/难过
	// 雷
	lei: "material-symbols:thunderstorm", // 雷暴/愤怒
	// 雪
	xue: "material-symbols:weather-snowy", // 雪/宁静
	qingxue: "material-symbols:sunny-snowing", // 晴雪/温馨
	// 雾
	wu: "material-symbols:foggy", // 雾/迷茫
	// 夜
	ye: "material-symbols:nightlight", // 夜/平静
	// 希望
	xingguang: "material-symbols:auto-awesome", // 星光/希望（库无彩虹，用星光替代）
};
// 解析 mood：返回 { icon: string | null, text: string | null }
// icon 非空 → 渲染图标；否则 text 非空 → 按 emoji 显示
const resolveMood = (mood?: string): { icon: string | null; text: string | null } => {
	if (!mood) return { icon: null, text: null };
	if (mood.includes(":")) return { icon: mood, text: null }; // 完整图标名
	const mapped = MOOD_ICONS[mood.trim()];
	if (mapped) return { icon: mapped, text: null }; // 天气拼音
	return { icon: null, text: mood }; // emoji
};

// ── 读取所有手账本（src/content/spec/journal-*.md，每本 = 一年） ──
const journalEntries = (await getCollection("spec")).filter((e) =>
	e.id.startsWith("journal-"),
);
if (journalEntries.length === 0) {
	return Astro.redirect("/404/");
}

type Book = {
	year: string;
	data: any;
	Content: any;
	paper: string;
	cover: {
		title: string;
		author: string;
		subtitle: string;
		date: string;
		paragraphs: string[];
	};
	intro: {
		title: string;
		paragraphs: string[];
	};
	enable: {
		moods: boolean;
		notes: boolean;
		todos: boolean;
		diary: boolean;
		quotes: boolean;
	};
	pages: any[];
	totalPages: number;
	monthGroups: Array<{
		key: string;
		label: string;
		days: Array<{ date: string; day: number; pageIdx: number }>;
	}>;
};

const books: Book[] = [];
for (const entry of journalEntries) {
	const { Content } = await render(entry);
	const d = entry.data;
	const pages = d.pages ?? [];
	const monthGroups: Book["monthGroups"] = [];
	pages.forEach((p: any, i: number) => {
		const ym = p.date.slice(0, 7);
		const month = p.date.slice(5, 7);
		const day = Number(p.date.slice(8, 10));
		let g = monthGroups.find((x) => x.key === ym);
		if (!g) {
			g = { key: ym, label: `${Number(month)} 月`, days: [] };
			monthGroups.push(g);
		}
		// 页码 = i + 2：0=封面，1=引言页（intro 为空时引言页不渲染，但仍保持 +2 序号统一）
		g.days.push({ date: p.date, day, pageIdx: i + 2 });
	});
	// hideJournal: true → 手账内容隐藏（年份下拉/书页不渲染），数据仍在文件里可随时恢复
	if (d.hideJournal) continue;
	books.push({
		year: d.year ?? entry.id.replace(/^journal-/, "").replace(/\.md$/, ""),
		data: d,
		Content,
		paper: d.paper ?? "lined",
		cover: {
			title: d.title ?? "我的手账",
			author: d.author ?? "牧河伊琉",
			subtitle: d.subtitle ?? "",
			date: d.date ?? "",
			paragraphs: (d.coverText ?? "")
				.split("\n")
				.map((s: string) => s.trim())
				.filter((s: string) => s.length > 0),
		},
		intro: {
			title: d.introTitle ?? "写在前面",
			paragraphs: (d.intro ?? "")
				.split("\n")
				.map((s: string) => s.trim())
				.filter((s: string) => s.length > 0),
		},
		enable: {
			moods: d.enableMoods !== false,
			notes: d.enableNotes !== false,
			todos: d.enableTodos !== false,
			diary: d.enableDiary !== false,
			quotes: d.enableQuotes !== false,
		},
		pages,
		totalPages: pages.length + 1,
		monthGroups,
	});
}

// 按年份升序，默认打开最近一年的本子
books.sort((a, b) => a.year.localeCompare(b.year));
// 支持 URL 参数直达：?year=2026&page=3（如从总结页返回时一步到位，避免先封面再跳页）
const urlYear = Astro.url.searchParams.get("year");
const urlPageRaw = Astro.url.searchParams.get("page");
const urlPage = urlPageRaw !== null ? Number(urlPageRaw) : null;
const activeYear =
	urlYear && books.some((b) => b.year === urlYear)
		? urlYear
		: books[books.length - 1].year;
const activePage =
	urlPage !== null && Number.isFinite(urlPage) && urlPage >= 0 ? urlPage : 0;
const cover = (books.find((b) => b.year === activeYear) ?? books[books.length - 1]).cover;
---

<!--
  数字手账（多页书册）
  内容全部在 src/content/spec/journal.md 里修改
-->

<MainGridLayout title={cover.title} description={cover.subtitle}>
	<!-- 手写字体：站酷快乐体（Google Fonts，运行时加载） -->
	<link rel="preconnect" href="https://fonts.googleapis.com" />
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	<link
		href="https://fonts.googleapis.com/css2?family=ZCOOL+KuaiLe&display=swap"
		rel="stylesheet"
	/>

	<div class="flex w-full rounded-(--radius-large) overflow-hidden relative">
		<div class="card-base z-10 px-4 py-5 sm:px-6 sm:py-6 relative w-full">
			<div class="j-app" data-total={books.length}>

				<!-- ══ 工具栏 ══ -->
				<div class="j-toolbar">
					<div class="j-btn-group">
					<button type="button" class="j-btn" id="j-toc-btn" aria-label="打开目录">
						<span class="j-btn-icon" aria-hidden="true">☰</span>
						<span>目录</span>
					</button>
					<a
						class="j-btn"
						id="j-summary-btn"
						href="/journal/summary/"
						aria-label="查看年度与月度总结"
					>
						<span class="j-btn-icon" aria-hidden="true">✦</span>
						<span>总结</span>
					</a>
					<a
						class="j-btn"
						id="j-todo-btn"
						href="/todo/"
						aria-label="打开待办事项"
					>
						<span class="j-btn-icon" aria-hidden="true">✓</span>
						<span>待办</span>
					</a>
					</div>
					<span class="j-page-indicator" id="j-page-indicator">1 / 1</span>
					<div class="j-controls">
						<select class="j-select" id="j-year-select" aria-label="切换手账年份">
							{books.map((b) => (
								<option value={b.year} selected={b.year === activeYear}>
									{b.year} 年
								</option>
							))}
						</select>
						<select class="j-select" id="j-paper-select" aria-label="纸张主题">
							<option value="lined">横线</option>
							<option value="blank">空白</option>
							<option value="kraft">牛皮纸</option>
						</select>
					</div>
					<div class="j-nav">
						<button type="button" class="j-btn j-nav-btn" id="j-prev" aria-label="上一页">
							<span aria-hidden="true">←</span>
						</button>
						<button type="button" class="j-btn j-nav-btn" id="j-next" aria-label="下一页">
							<span aria-hidden="true">→</span>
						</button>
						<button
							type="button"
							class="j-btn"
							id="j-share-btn"
							aria-label="分享当前页"
							title="分享当前页"
						>
							<span>分享</span>
						</button>
					</div>
				</div>

				<!-- ══ 书册（按年份分本，点击两侧露出的卡片翻页） ══ -->
				<div class="j-stage">
					<div id="j-years">
					{books.map((book) => (
					<div class="j-year-book" data-year={book.year} hidden={book.year !== activeYear}>
					<div class="j-book" data-paper={book.paper}>

					<!-- 封面 -->
					<section
						class="j-sheet j-cover"
						data-page="0"
						data-state={book.year === activeYear && activePage === 0 ? "active" : "hidden"}
					>
						<div class="j-cover-frame">
							<div class="j-cover-inner">
								<!-- 装饰区：胶带 + 贴纸 + 手绘小花 -->
								<div class="j-cover-tape j-cover-tape-a" aria-hidden="true"></div>
								<div class="j-cover-tape j-cover-tape-b" aria-hidden="true"></div>
								<svg class="j-cover-flower j-cover-flower-tl" viewBox="0 0 24 24" aria-hidden="true">
									<path fill="currentColor" d="M3 13a9 9 0 0 0 9 9c0-5-4.03-9-9-9m9-7.5A2.5 2.5 0 0 1 14.5 8a2.5 2.5 0 0 1-2.5 2.5A2.5 2.5 0 0 1 9.5 8A2.5 2.5 0 0 1 12 5.5m-6.4 4.75a2.5 2.5 0 0 0 2.5 2.5c.53 0 1.02-.17 1.4-.44v.19A2.5 2.5 0 0 0 12 15a2.5 2.5 0 0 0 2.5-2.5v-.19c.38.27.87.44 1.4.44a2.5 2.5 0 0 0 2.5-2.5c0-1-.59-1.85-1.43-2.25c.84-.4 1.43-1.26 1.43-2.25a2.5 2.5 0 0 0-2.5-2.5c-.53 0-1.02.16-1.4.44V3.5A2.5 2.5 0 0 0 12 1a2.5 2.5 0 0 0-2.5 2.5v.19c-.38-.28-.87-.44-1.4-.44a2.5 2.5 0 0 0-2.5 2.5c0 .99.59 1.85 1.43 2.25c-.84.4-1.43 1.25-1.43 2.25M12 22a9 9 0 0 0 9-9c-5 0-9 4-9 9"/>
								</svg>
								<svg class="j-cover-flower j-cover-flower-br" viewBox="0 0 24 24" aria-hidden="true">
									<path fill="currentColor" d="M12 9c1.59 7.61-2 13-2 13h3c1.88-5.8 1-9.91.5-12m2.16-2.84c.17.21.34.43.47.66a7.1 7.1 0 0 1-.63 8.44a7.11 7.11 0 0 0-.55-6.49c-.08-.13-.17-.24-.25-.36a7.1 7.1 0 0 0-2.16-1.98a7.13 7.13 0 0 0-4.96 6.79c0 .74.11 1.45.31 2.11a7.07 7.07 0 0 1-1.33-4.14c0-2.35 1.14-4.43 2.89-5.73C8 6.35 6.46 6.67 5.12 7.5q-.93.615-1.62 1.41C4.05 7.58 5 6.39 6.3 5.57c1.5-.94 3.2-1.25 4.84-1.01C10.73 4 10.23 3.47 9.63 3c-.58-.42-1.21-.76-1.87-1c1.44.04 2.88.5 4.11 1.43c.63.47 1.13 1.04 1.53 1.64c.1 0 .19-.01.29-.01c3.2 0 5.91 2.11 6.81 5.02a7.07 7.07 0 0 0-4.84-2.92"/>
								</svg>
								<span class="j-cover-sticker" aria-hidden="true">
									<svg class="j-cover-sticker-icon" viewBox="0 0 24 24">
										<path fill="currentColor" d="M3 13a9 9 0 0 0 9 9a9 9 0 0 0-9-9m9 9a9 9 0 0 0 9-9a9 9 0 0 0-9 9m6-19v5a6 6 0 0 1-6 6a6 6 0 0 1-6-6V3c.74 0 1.47.12 2.16.39c.55.23 1.04.57 1.45 1L12 2l2.39 2.39c.41-.43.9-.77 1.45-1A5.9 5.9 0 0 1 18 3"/>
									</svg>
								</span>
								<span class="j-cover-dot j-cover-dot-1" aria-hidden="true"></span>
								<span class="j-cover-dot j-cover-dot-2" aria-hidden="true"></span>
								<span class="j-cover-dot j-cover-dot-3" aria-hidden="true"></span>

								<!-- 标题区 -->
								{book.cover.date && <div class="j-cover-date">{book.cover.date}</div>}
								<h2 class="j-cover-title">{book.cover.title}</h2>
								{book.cover.subtitle && <p class="j-cover-subtitle">{book.cover.subtitle}</p>}
								<div class="j-cover-divider" aria-hidden="true"></div>

								<!-- 正文区（可编辑段落） -->
								{book.cover.paragraphs.length > 0 && (
									<div class="j-cover-text">
										{book.cover.paragraphs.map((line) => (
											<p>{line}</p>
										))}
									</div>
								)}

								<!-- 署名区 -->
								<div class="j-cover-author">—— {book.cover.author}</div>
							</div>
						</div>
					</section>

					<!-- 引言页（封面之后；frontmatter 的 intro 为空则不渲染） -->
					{book.intro.paragraphs.length > 0 && (
						<section
							class="j-sheet j-intro"
							data-page="1"
							data-state={book.year === activeYear && activePage === 1 ? "active" : "hidden"}
						>
							<div class="j-sheet-inner">
								<div class="j-intro-body">
									<div class="j-intro-badge" aria-hidden="true">序</div>
									{book.intro.title && <h2 class="j-intro-title">{book.intro.title}</h2>}
									<div class="j-intro-rule" aria-hidden="true"></div>
									<div class="j-intro-text">
										{book.intro.paragraphs.map((line) => (
											<p>{line}</p>
										))}
									</div>
								</div>
							</div>
							<div class="j-footer" aria-hidden="true">
								<span class="j-footer-line"></span>
								<span class="j-footer-mark">✦ 01</span>
							</div>
							<div class="j-watermark" aria-hidden="true">
								<svg viewBox="0 0 24 24">
									<path fill="currentColor" d="M3 13a9 9 0 0 0 9 9c0-5-4.03-9-9-9m9-7.5A2.5 2.5 0 0 1 14.5 8a2.5 2.5 0 0 1-2.5 2.5A2.5 2.5 0 0 1 9.5 8A2.5 2.5 0 0 1 12 5.5m-6.4 4.75a2.5 2.5 0 0 0 2.5 2.5c.53 0 1.02-.17 1.4-.44v.19A2.5 2.5 0 0 0 12 15a2.5 2.5 0 0 0 2.5-2.5v-.19c.38.27.87.44 1.4.44a2.5 2.5 0 0 0 2.5-2.5c0-1-.59-1.85-1.43-2.25c.84-.4 1.43-1.26 1.43-2.25a2.5 2.5 0 0 0-2.5-2.5c-.53 0-1.02.16-1.4.44V3.5A2.5 2.5 0 0 0 12 1a2.5 2.5 0 0 0-2.5 2.5v.19c-.38-.28-.87-.44-1.4-.44a2.5 2.5 0 0 0-2.5 2.5c0 .99.59 1.85 1.43 2.25c-.84.4-1.43 1.25-1.43 2.25M12 22a9 9 0 0 0 9-9c-5 0-9 4-9 9"/>
								</svg>
							</div>
						</section>
					)}

					<!-- 内页 -->
					{book.pages.map((p, i) => (
						<section
							class="j-sheet"
							data-page={i + 2}
							data-date={p.date}
							data-state={book.year === activeYear && activePage === i + 2 ? "active" : "hidden"}
						>
							<div class="j-sheet-inner">
								<!-- 日期头 -->
								<header class="j-head">
									<div class="j-head-left">
										<span class="j-head-date">{fmtDay(p.date)}</span>
										{p.title && <span class="j-head-title">{p.title}</span>}
									</div>
									{/* 心情：可填 emoji / 天气拼音（qing 晴、yin 阴…）/ 图标名（material-symbols:xxx） */}
									{p.mood && (() => {
										const m = resolveMood(p.mood);
										return m.icon ? (
											<Icon name={m.icon} class="j-head-mood-icon" />
										) : (
											<span class="j-head-mood">{m.text}</span>
										);
									})()}
								</header>

								<!-- 心情文字行（保持在头部下方原位，不参与垂直居中） -->
								{book.enable.moods && p.mood && (() => {
									const m = resolveMood(p.mood);
									return m.icon ? (
										<p class="j-mood-line">
											今日心情：
											<Icon name={m.icon} class="j-mood-line-icon" />
										</p>
									) : (
										<p class="j-mood-line">今日心情：{m.text}</p>
									);
								})()}

								<!-- 正文内容区（内容少时垂直居中，头部与心情保持顶部） -->
								<div class="j-content">
								{p.images && p.images.length > 0 && (
									<div class:list={["j-imgs", p.images.length > 1 && "j-imgs-multi"]}>
										{p.images.map((src) => (
											<img
												src={src}
												alt=""
												loading="lazy"
												class:list={["j-img", p.imagePortrait && "j-img-portrait"]}
											/>
										))}
									</div>
								)}

								<!-- 便签（单数自动变长条：1 个占满整行；3/5 个最后一个横跨整行） -->
								{book.enable.notes && p.notes && p.notes.length > 0 && (
									<div class="j-block">
										<h3 class="j-sec-title">✎ 便签</h3>
										<div
											class:list={[
												"j-notes",
												p.notes.length === 1 && "j-notes-single",
												p.notes.length % 2 === 1 &&
													p.notes.length > 1 &&
													"j-notes-last-full",
											]}
										>
											{p.notes.map((n) => (
												<article
													class:list={["j-note", `note-${n.color ?? "yellow"}`]}
													style={`--note-rotate: ${n.rotate ?? 0}deg`}
												>
													<h4 class="j-note-title">{n.title}</h4>
													<p class="j-note-content">{n.content}</p>
												</article>
											))}
										</div>
									</div>
								)}

								<!-- 待办 -->
								{book.enable.todos && p.todos && p.todos.length > 0 && (
									<div class="j-block">
										<h3 class="j-sec-title">☑ 待办清单</h3>
										<ul class="j-todos">
											{p.todos.map((t) => (
												<li class="j-todo-item">
													<label class="j-todo-label">
														<input
															type="checkbox"
															checked={t.done}
															aria-label={t.text}
														/>
														<span class="j-todo-text">{t.text}</span>
													</label>
												</li>
											))}
										</ul>
										<p class="j-todo-count">
											已完成 <span class="j-todo-num">0</span> / {p.todos.length} 项 ✧
										</p>
									</div>
								)}

								<!-- 日记（JS 从正文注入） -->
								{book.enable.diary && (
									<div class="j-block j-diary">
										<h3 class="j-sec-title">☁ 日记</h3>
										<div class="j-diary-slot">
											<p class="j-diary-empty">（这一天还没有写日记……）</p>
										</div>
									</div>
								)}

								<!-- 摘抄 -->
								{book.enable.quotes && p.quotes && p.quotes.length > 0 && (
									<div class="j-block">
										<h3 class="j-sec-title">❝ 摘抄</h3>
										<div class="j-quotes">
											{p.quotes.map((q) => (
												<figure class="j-quote">
													<blockquote class="j-quote-text">「{q.text}」</blockquote>
													{q.author && (
														<figcaption class="j-quote-author">—— {q.author}</figcaption>
													)}
												</figure>
											))}
										</div>
									</div>
								)}
								</div>
								<!-- 底部占位：把垂直居中的下界精确对齐到花印顶部（距底 3.65rem） -->
								<div class="j-foot-spacer" aria-hidden="true"></div>
							</div>
							<!-- 页脚收尾 + 角落水印（填补底部空白） -->
							<div class="j-footer" aria-hidden="true">
								<span class="j-footer-line"></span>
								<span class="j-footer-mark">✦ {String(i + 2).padStart(2, "0")}</span>
							</div>
							<div class="j-watermark" aria-hidden="true">
								<svg viewBox="0 0 24 24">
