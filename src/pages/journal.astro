      let diaryText = sheet?.querySelector(".j-diary-slot")?.textContent?.trim().replace(/\s+/g, " ");
      if (!diaryText || diaryText === "\uFF08\u8FD9\u4E00\u5929\u8FD8\u6CA1\u6709\u5199\u65E5\u8BB0\u2026\u2026\uFF09") {
        diaryText = "\u8FD9\u4E00\u5929\uFF0C\u4EC0\u4E48\u4E5F\u6CA1\u6765\u5F97\u53CA\u5199\u3002";
      }
      ctx.font = `400 32px ${FONT}`;
      ctx.fillStyle = "rgba(92,80,64,0.9)";
      const diaryY = 280;
      const diaryHeight = wrapText(ctx, diaryText, 70, diaryY, W - 140, 54, 9999);
      let contentBottom = diaryY + diaryHeight + 20;
      // 图片：全部绘制，单张更大，多张 2 列并排、超过 2 张换行
      if (imgs.length > 0) {
        const gap = 14;
        const totalW = W - 140;
        const colW = (totalW - gap) / 2;
        let imgY = contentBottom;
        // 逐行排布：每行最多 2 张
        for (let r = 0; r * 2 < imgs.length; r++) {
          const rowImgs = imgs.slice(r * 2, r * 2 + 2);
          const single = rowImgs.length === 1;
          let rowH = 0;
          const laid = rowImgs.map((img, c) => {
            const isPortrait = img.naturalHeight > img.naturalWidth;
            let dw = single ? totalW : colW;
            let dh = single ? 220 : 150;
            if (single && isPortrait) {
              // 单张竖图：高按比例，最大 320
              const ratio = img.naturalWidth / img.naturalHeight;
              dw = Math.min(totalW * 0.62, 340);
              dh = dw / ratio;
              if (dh > 320) {
                dh = 320;
                dw = dh * ratio;
              }
            } else if (!single && isPortrait) {
              // 多张中的竖图：保持比例，限高 220
              const ratio = img.naturalWidth / img.naturalHeight;
              dw = colW * 0.62;
              dh = dw / ratio;
              if (dh > 220) {
                dh = 220;
                dw = dh * ratio;
              }
            }
            rowH = Math.max(rowH, dh);
            return { img, dw, dh, dx: 70 + c * (colW + gap), dy: imgY, isPortrait };
          });
          // 单张且横向图片：横图保持 220 高全宽
          laid.forEach(({ img, dw, dh, dx, dy }) => {
            const sRatio = img.naturalWidth / img.naturalHeight;
            const tRatio = dw / dh;
            let sx = 0, sy = 0, sW = img.naturalWidth, sH = img.naturalHeight;
            if (sRatio > tRatio) {
              sH = img.naturalHeight;
              sW = sH * tRatio;
              sx = (img.naturalWidth - sW) / 2;
            } else {
              sW = img.naturalWidth;
              sH = sW / tRatio;
              sy = (img.naturalHeight - sH) / 2;
            }
            const cdx = dx + (colW - dw) / 2;
            ctx.save();
            ctx.beginPath();
            drawRoundRect(ctx, cdx, dy, dw, dh, 10);
            ctx.clip();
            ctx.drawImage(img, sx, sy, sW, sH, cdx, dy, dw, dh);
            ctx.restore();
          });
          imgY += rowH + gap;
        }
        contentBottom = imgY;
      }
      const notes = Array.from(sheet?.querySelectorAll(".j-note") || []);
      let notesBottom = contentBottom;
      if (notes.length) {
        // 便签全部绘制：每行最多 2 张，超过换行；单张 → 长条铺满整行
        const nw = 340;
        const nh = 200;
        const nGap = 30;
        for (let r = 0; r * 2 < notes.length; r++) {
          const rowNotes = notes.slice(r * 2, r * 2 + 2);
          const rowSingle = rowNotes.length === 1;
          const rw = rowSingle ? W - 140 : nw;
          const ny = notesBottom + 10;
          rowNotes.forEach((n, c) => {
            const nx = rowSingle ? 70 : 70 + c * (rw + nGap);
            const cls = n.className;
            const isPink = cls.includes("note-pink");
            const isBlue = cls.includes("note-blue");
            const isGreen = cls.includes("note-green");
            const isOrange = cls.includes("note-orange");
            const isPurple = cls.includes("note-purple");
            const isGray = cls.includes("note-gray");
            const nb = isPink
              ? "#ffdbe4"
              : isBlue
                ? "#d9ecff"
                : isGreen
                  ? "#ddf2d8"
                  : isOrange
                    ? "#ffe6c8"
                    : isPurple
                      ? "#f0e0ff"
                      : isGray
                        ? "#e8e6e2"
                        : "#fff7c2";
            const nink = isPink
              ? "#8c2f44"
              : isBlue
                ? "#1e4d7a"
                : isGreen
                  ? "#2c5f33"
                  : isOrange
                    ? "#8a4a12"
                    : isPurple
                      ? "#5b2d8a"
                      : isGray
                        ? "#4a4740"
                        : "#5d5310";
            ctx.save();
            ctx.translate(nx + rw / 2, ny + nh / 2);
            ctx.rotate((c === 0 ? -1 : 1) * 0.03);
            ctx.fillStyle = nb;
            ctx.shadowColor = "rgba(0,0,0,0.12)";
            ctx.shadowBlur = 14;
            ctx.shadowOffsetY = 6;
            drawRoundRect(ctx, -rw / 2, -nh / 2, rw, nh, 10);
            ctx.fill();
            ctx.shadowColor = "transparent";
            const t = n.querySelector(".j-note-title")?.textContent?.trim() || "";
            const cc = n.querySelector(".j-note-content")?.textContent?.trim() || "";
            ctx.fillStyle = nink;
            ctx.textAlign = "left";
            ctx.font = `400 26px ${FONT}`;
            ctx.fillText(t, -rw / 2 + 26, -nh / 2 + 48);
            ctx.font = `400 22px ${FONT}`;
            wrapText(ctx, cc, -rw / 2 + 26, -nh / 2 + 88, rw - 52, 32, 3);
            ctx.restore();
          });
          notesBottom = ny + nh;
        }
      }
      const bookAuthor = b.book.querySelector(".j-cover-author")?.textContent?.trim() || "\u2014\u2014 \u7267\u6CB3\u4F0A\u7409";
      ctx.font = `400 30px ${FONT}`;
      ctx.fillStyle = "rgba(124,111,99,0.78)";
      ctx.textAlign = "center";
      const authorY = notesBottom + 40;
      ctx.fillText(bookAuthor, W / 2, authorY);
      return authorY + 30;
    }
    return 1200;
  }
    // 第一遍：用临时 canvas 测量内容底部，得到总高度（确保长内容完整容纳）
    const measureCanvas = document.createElement("canvas");
    measureCanvas.width = W;
    measureCanvas.height = 6000;
    const mctx = measureCanvas.getContext("2d");
    if (!mctx) return "";
    const contentBottom = render(mctx, 6000);
    const H = Math.max(1200, contentBottom + 60);
    // 第二遍：按算出的高度正式绘制
    const canvas = document.createElement("canvas");
    canvas.width = W;
    canvas.height = H;
    const ctx = canvas.getContext("2d");
    if (!ctx) return "";
    render(ctx, H);
    return canvas.toDataURL("image/png");
  }
  async function generateShare() {
    const b = getCurrentBook();
    if (!b || !sharePanel) return;
    openShare();
    if (shareImg) shareImg.style.opacity = "0";
    if (shareLoading) shareLoading.style.display = "block";
    try {
      await document.fonts.ready;
    } catch (e) {
    }
    shareDataUrl = await drawShareCard(b, b.current);
    if (shareImg) {
      shareImg.src = shareDataUrl;
      shareImg.style.opacity = "1";
    }
    if (shareLoading) shareLoading.style.display = "none";
  }
  shareBtn?.addEventListener("click", generateShare);

  // 总结按钮：点击时携带当前选中的手账年份，让总结页默认打开该年
  // #main-grid 锚点：整页加载时浏览器原生定位到正文，避免先闪全屏壁纸再滚动
  const summaryBtn = document.getElementById("j-summary-btn");
  summaryBtn?.addEventListener("click", () => {
    if (summaryBtn && yearSelect.value) {
      summaryBtn.href = "/journal/summary/?year=" + yearSelect.value + "#main-grid";
    }
  });

  // 全屏壁纸模式定位：手账页被 data-no-swup 整页加载（绕过 Swup 的 scroll:top 钩子），
  // 这里手动复刻 Layout.astro scroll:top 钩子的逻辑：
  // 全屏壁纸模式 + 非首页 → 滚动到 #main-grid（正文容器顶部），避免停在壁纸顶部
  function scrollToContentIfFullscreen() {
    try {
      if (document.documentElement.getAttribute("data-wallpaper-mode") !== "fullscreen") return;
      if (window.location.pathname.replace(/\/+$/, "") === "") return; // 首页不滚
      const mainGrid = document.getElementById("main-grid");
      if (mainGrid) mainGrid.scrollIntoView({ behavior: "auto" });
    } catch (e) {}
  }
  // 时机：等 DOMContentLoaded 同步初始化（initWallpaperMode 已把主内容定位到壁纸下方并显示）后再滚动，
  // 避免整页加载时先在壁纸位置滚动导致"闪一下壁纸"；load 兜底保证图片/字体就绪后位置正确
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", () => {
      setTimeout(scrollToContentIfFullscreen, 0);
    });
  } else {
    scrollToContentIfFullscreen();
  }
  window.addEventListener("load", scrollToContentIfFullscreen);
}
initJournal();
if (!window.__journalSwupBound) {
  window.__journalSwupBound = true;
  document.addEventListener("swup:contentReplaced", () => initJournal());
}
