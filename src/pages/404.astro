---
import MainGridLayout from "@/layouts/MainGridLayout.astro";
---

<MainGridLayout title="页面走丢了" description="可能是被风吹走了……">
  <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-96">
    <div class="card-base z-10 px-6 py-8 relative w-full flex flex-col items-center justify-center text-center">

      <!-- 404 大字 -->
      <div class="text-8xl md:text-9xl font-bold text-(--primary) opacity-15 leading-none mb-2">
        404
      </div>

      <!-- 图片 -->
      <div class="w-48 h-48 md:w-56 md:h-56 rounded-full overflow-hidden shadow-lg mb-6 ring-2 ring-(--primary)/20">
        <img
          src="/images/404-illustration.png"
          alt="404 插图"
          class="w-full h-full object-cover"
        />
      </div>

      <!-- 文案 -->
      <p class="text-xl md:text-2xl text-75 mb-2 font-medium">
        这片领地还没建好~
      </p>
      <p class="text-sm text-50 mb-8">
        可能是被风吹走了，也可能是想偷偷躲起来
      </p>

      <!-- 回首页 -->
      <a
        href="/"
        class="inline-flex items-center gap-2 px-6 py-3 bg-(--primary) text-white rounded-(--radius-large) hover:bg-(--btn-content) transition-all duration-200 font-medium hover:-translate-y-0.5 hover:shadow-lg"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 12a9 9 0 1 0 18 0 9 9 0 0 0-18 0z"/>
          <path d="M9 12h6"/>
          <path d="m12 9 3 3-3 3"/>
        </svg>
        回首页逛逛
      </a>

    </div>
  </div>
</MainGridLayout>

<style>
  .card-base {
    animation: fadeInUp 0.6s ease-out;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* 图片容器柔和阴影 */
  img {
    filter: drop-shadow(0 0 8px color-mix(in srgb, var(--primary) 25%, transparent));
  }
</style>