---
/**
 * =========================================================
 *  📄 驻足之旅 - 手动维护页面
 *  =========================================================
 *  
 *  你不用动这个文件！
 *  只管去改 src/data/collections.ts 里面的数据就行
 *  =========================================================
 */
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import {
  animeList,
  gameList,
  bookList,
  musicList,
  movieList,
  tvList,
} from "@/data/collections";

// ── 六个分类 ──
const categories = [
  { id: "anime", label: "动漫",     accent: "bg-sky-500", items: animeList },
  { id: "book",  label: "书籍",     accent: "bg-amber-500", items: bookList },
  { id: "music", label: "音乐",     accent: "bg-rose-500", items: musicList },
  { id: "movie", label: "银幕记忆", accent: "bg-fuchsia-500", items: movieList },
  { id: "tv",    label: "剧集时光", accent: "bg-emerald-500", items: tvList },
  { id: "game",  label: "游戏",     accent: "bg-violet-500", items: gameList },
];

// ── 只显示有数据的分类 ──
const activeCategories = categories.filter((cat) => cat.items.length > 0);

const pageTitle = "驻足之旅";
const pageDesc = "那些在记忆中刻下痕迹的作品";
---

<MainGridLayout title={pageTitle} description={pageDesc}>
  <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
    <div class="card-base z-10 px-5 sm:px-9 py-6 relative w-full">

      {/* ===== 页面标题 ===== */}
      <div class="mb-6">
        <div class="flex items-center gap-3 mb-1">
          <div class="h-8 w-8 rounded-lg bg-gradient-to-br from-sky-500 to-fuchsia-500 flex items-center justify-center text-white text-sm font-bold">
            Z
          </div>
          <div class="text-3xl font-bold text-neutral-900 dark:text-neutral-100">
            {pageTitle}
          </div>
        </div>
        <p class="text-sm text-neutral-500 dark:text-neutral-400 ml-11 mt-1">
          {pageDesc}
        </p>
      </div>

      {/* ===== 分类 Tab 导航 ===== */}
      {activeCategories.length > 1 && (
        <nav id="category-tabs" class="py-3 mb-6 bg-white/80 dark:bg-neutral-900/80 backdrop-blur-md border-b border-(--line-divider)">
          <div class="flex flex-wrap gap-2">
            {activeCategories.map((cat, idx) => (
              <button
                data-category={cat.id}
                class={`tab-btn group inline-flex items-center gap-2 px-3 py-1.5 rounded-lg text-sm
                       transition-all duration-200 cursor-pointer border-none
                       ${idx === 0
                         ? "text-neutral-900 dark:text-neutral-100 bg-neutral-100 dark:bg-neutral-800 font-semibold"
                         : "text-neutral-500 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-100 hover:bg-neutral-100 dark:hover:bg-neutral-800"
                       }`}
              >
                <span class={`h-2 w-2 rounded-full ${cat.accent} shrink-0`}></span>
                <span>{cat.label}</span>
                <span class="text-xs text-neutral-400 dark:text-neutral-500 ml-0.5">
                  {cat.items.length}
                </span>
              </button>
            ))}
          </div>
        </nav>
      )}

      {/* ===== 没有数据时的提示 ===== */}
      {activeCategories.length === 0 && (
        <div class="text-center py-16">
          <div class="text-[3rem] text-neutral-300 dark:text-neutral-600 mb-4">?</div>
          <p class="text-neutral-500 dark:text-neutral-400 text-lg">
            还没有添加任何内容哦～
          </p>
          <p class="text-neutral-400 dark:text-neutral-500 text-sm mt-2">
            去 <code class="text-(--primary) bg-(--btn-regular-bg) px-1.5 py-0.5 rounded text-sm">src/data/collections.ts</code> 添加你的第一条记录吧！
          </p>
        </div>
      )}

      {/* ===== Tab 内容区 ===== */}
      {activeCategories.map((category, idx) => (
        <section
          data-category={category.id}
          class="tab-content"
          style={`display: ${idx === 0 ? "block" : "none"}`}
        >
          {/* 分类标题 */}
          <div class="flex items-center gap-3 mb-4">
            <span class={`h-5 w-1 rounded-full ${category.accent} shrink-0`}></span>
            <h2 class="text-xl font-bold text-neutral-900 dark:text-neutral-100">
              {category.label}
            </h2>
            <span class="text-sm text-neutral-400 dark:text-neutral-500 ml-1">
              ({category.items.length})
            </span>
          </div>

          {/* 卡片网格 */}
          <div class="collections-grid">
            {category.items.map((item) => {
              return (
                <div
                  class={`group relative overflow-hidden rounded-xl border transition-all duration-300
                          hover:shadow-lg hover:scale-[1.02]
                          ${item.highlight
                            ? "border-sky-400 dark:border-sky-500 ring-2 ring-sky-400/30 dark:ring-sky-500/30 shadow-md shadow-sky-400/10"
                            : "border-(--line-divider)"
                          }`}
                >
                  {/* 封面图（占满整卡，名字叠在底部） */}
                  <div class="aspect-[2/3] relative overflow-hidden bg-neutral-100 dark:bg-neutral-800">
                    <img
                      src={item.cover}
                      alt={item.nameCn || item.name}
                      class="w-full h-full object-cover pointer-events-none transition-transform duration-500 group-hover:scale-105"
                      loading="lazy"
                      decoding="async"
                    />

                    {/* 高亮标记 - 左上角 */}
                    {item.highlight && (
                      <div class="absolute top-2 left-2">
                        <span class="px-2 py-0.5 rounded-md text-xs font-bold
                                    bg-sky-500 text-white shadow-md">
                          推荐
                        </span>
                      </div>
                    )}

                    {/* 名称叠加 - 底部 */}
                    <div class="absolute bottom-0 left-0 right-0 px-3 py-2.5
                                bg-gradient-to-t from-black/80 via-black/40 to-transparent">
                      <div class="font-bold text-sm text-white leading-tight">
                        {item.nameCn || item.name}
                      </div>
                      {item.nameCn && item.name !== item.nameCn && (
                        <div class="text-[11px] text-white/70 truncate mt-0.5">
                          {item.name}
                        </div>
                      )}
                    </div>

                    {/* 附注（note）在名称上面 */}
                    {item.note && (
                      <div class="absolute bottom-[60px] left-0 right-0 px-3 py-1.5">
                        <span class="text-[10px] text-white/80 leading-tight block drop-shadow-md">
                          {item.note}
                        </span>
                      </div>
                    )}
                  </div>

                  {/* 底部评论区 - 永远可见 */}
                  {(item.comment || (item.tags && item.tags.length > 0)) && (
                    <div class="px-2.5 py-2 border-t border-(--line-divider)">
                      {item.comment && (
                        <p class="text-[11px] text-neutral-500 dark:text-neutral-400 leading-relaxed">
                          {item.comment}
                        </p>
                      )}
                      {item.tags && item.tags.length > 0 && (
                        <div class="flex flex-wrap gap-1 mt-1.5">
                          {item.tags.map((tag) => (
                            <span class="px-1.5 py-0.5 rounded text-[10px] font-medium
                                        bg-neutral-100 dark:bg-neutral-800
                                        text-neutral-500 dark:text-neutral-400">
                              {tag}
                            </span>
                          ))}
                        </div>
                      )}
                    </div>
                  )}
                </div>
              );
            })}
          </div>
        </section>
      ))}
    </div>
  </div>
</MainGridLayout>

<style>
  /* 网格布局 */
  .collections-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }

  @media (min-width: 640px) {
    .collections-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
    }
  }

  @media (min-width: 1024px) {
    .collections-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
    }
  }

  @media (min-width: 1280px) {
    .collections-grid {
      grid-template-columns: repeat(5, 1fr);
      gap: 1rem;
    }
  }

  /* Tab 按钮去掉默认样式 */
  .tab-btn {
    font-family: inherit;
    font-size: inherit;
    outline: none;
  }
  .tab-btn:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }
</style>
