---
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";

const allEntries = await getCollection("spec");
const journalEntries = allEntries.filter((e) => e.id.startsWith("journal-"));
if (journalEntries.length === 0) {
	return Astro.redirect("/404/");
}

// 解析每本手账的年度/月度总结数据（数字自动统计：总记录数、覆盖月份数）
const CN_MONTHS = ["一", "二", "三", "四", "五", "六", "七", "八", "九", "十", "十一", "十二"];

// ── 心情 = 天气拼音 → 图标（与 journal.astro 保持一致）──
const MOOD_ICONS: Record<string, string> = {
	qing: "material-symbols:wb-sunny",
	duoyun: "material-symbols:partly-cloudy-day",
	yin: "material-symbols:cloud",
	yu: "material-symbols:rainy",
	xiaoyu: "material-symbols:rainy-light",
	dayu: "material-symbols:rainy-heavy",
	lei: "material-symbols:thunderstorm",
	xue: "material-symbols:weather-snowy",
	qingxue: "material-symbols:sunny-snowing",
	wu: "material-symbols:foggy",
	ye: "material-symbols:nightlight",
	xingguang: "material-symbols:auto-awesome",
};
// 把 mood 解析成可直接渲染的图标名（拼音 → 图标，完整图标名原样返回）
const resolveMoodIcon = (mood?: string): string => {
	if (!mood) return "";
	if (mood.includes(":")) return mood;
	return MOOD_ICONS[mood.trim()] || mood;
};

const books = journalEntries
	.map((entry) => {
		const d = entry.data;
		const pages = d.pages ?? [];
		const monthly = (d.monthly ?? []).map((m: any) => ({
			...m,
			year: m.month.slice(0, 4),
			monthLabel: `${CN_MONTHS[Number(m.month.slice(5, 7)) - 1] ?? m.month}月`,
			paragraphs: (m.body ?? "")
				.split("\n")
				.map((s: string) => s.trim())
				.filter((s: string) => s.length > 0),
			events: (m.events ?? []).map((ev: any) => ({
				...ev,
				mood: resolveMoodIcon(ev.mood),
			})),
		}));
		return {
			year: d.year ?? entry.id.replace(/^journal-/, "").replace(/\.md$/, ""),
			title: d.title ?? "我的手账",
			annual: d.annual ?? null,
			monthly,
			hideAnnual: d.hideAnnual ?? false,
			hideMonthly: d.hideMonthly ?? false,
			stats: {
				records: pages.length,
				months: new Set(pages.map((p: any) => p.date.slice(0, 7))).size,
			},
		};
	})
	.sort((a, b) => a.year.localeCompare(b.year));

// 总结页可切换的年份：有可见的年度总结或月度总结的年份（hideAnnual/hideMonthly 控制）
const yearGroups = books
	.filter((b) => (b.annual && !b.hideAnnual) || (b.monthly.length > 0 && !b.hideMonthly))
	.map((b) => b.year)
	.sort();
const activeYear = yearGroups.at(-1) ?? "";
// 年度视图数据（有 annual 且未隐藏的年份）
const annualBooks = books.filter((b) => b.annual && !b.hideAnnual);
// 月度视图数据（有 monthly 且未隐藏的年份）
const monthlyBooks = books.filter((b) => b.monthly.length > 0 && !b.hideMonthly);
// 第一个有月度数据的月份（默认展开）
const firstMonthKey = books.flatMap((b) => b.monthly)[0]?.month ?? "";
---

<MainGridLayout
	title="我的总结"
	description="年度回顾与月度档案"
>
	<link rel="preconnect" href="https://fonts.googleapis.com" />
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	<link
		href="https://fonts.googleapis.com/css2?family=ZCOOL+KuaiLe&display=swap"
		rel="stylesheet"
	/>

	<div class="sum-app" id="sum-app" data-default-year={activeYear} data-default-month={firstMonthKey}>
		<!-- ══ 顶部：返回 + 标题 + 视图切换 ══ -->
		<header class="sum-head">
			<div class="sum-head-left">
				<a class="sum-back" href="/journal/" data-sum-back aria-label="返回手账">
					<span aria-hidden="true">←</span> 返回手账
				</a>
				<h1 class="sum-title">手账总结</h1>
			</div>
			<div class="sum-tabs" role="tablist" aria-label="切换总结视图">
				<button type="button" class="sum-tab" data-sum-tab="annual" role="tab">
					年度回顾
				</button>
				<button type="button" class="sum-tab" data-sum-tab="monthly" role="tab">
					月度档案
				</button>
			</div>
		</header>

		<!-- 年份选择器：点击切换年份，两个视图内容自动更新 -->
		<nav class="sum-yearbar" aria-label="选择总结年份">
			{yearGroups.map((y) => (
				<button
					type="button"
					class="sum-year-btn"
					data-sum-year-btn={y}
					class:list={[
						"sum-year-btn",
						y === activeYear && "sum-year-btn-active",
					]}
				>
					{y}
				</button>
			))}
		</nav>

		<!-- ══ 年度视图（暖橙 · 里程碑回顾） ══ -->
		<section class="sum-pane" data-sum-pane="annual">
			{annualBooks.map((b) => (
				<article
					class="sum-annual"
					data-sum-annual-year={b.year}
					hidden={b.year !== activeYear}
				>
				{b.annual ? (
				<>
					<!-- Hero -->
					<div class="sum-hero">
						<span class="sum-hero-year">{b.year}</span>
						<p class="sum-hero-tagline">{b.annual?.tagline ?? "把这一年，好好收个尾。"}</p>
						<div class="sum-hero-rule" aria-hidden="true"></div>
					</div>

					<!-- 全年概览（数字自动统计） -->
					<div class="sum-section">
						<h2 class="sum-sec-title"><span class="sum-sec-no">01</span> 全年概览</h2>
						<div class="sum-cards">
							<div class="sum-card">
								<p class="sum-card-label">记录天数</p>
								<p class="sum-card-num">{b.stats.records}</p>
								<p class="sum-card-note">页</p>
							</div>
							<div class="sum-card">
								<p class="sum-card-label">覆盖月份</p>
								<p class="sum-card-num">{b.stats.months}</p>
								<p class="sum-card-note">个月</p>
							</div>
							<div class="sum-card">
								<p class="sum-card-label">重要事件</p>
								<p class="sum-card-num">{(b.annual?.events ?? []).length}</p>
								<p class="sum-card-note">件</p>
							</div>
						</div>
					</div>

					<!-- 重要事件回顾 -->
					{b.annual?.events && b.annual.events.length > 0 && (
						<div class="sum-section">
							<h2 class="sum-sec-title"><span class="sum-sec-no">02</span> 重要事件回顾</h2>
							<ol class="sum-timeline">
								{b.annual.events.map((ev) => (
									<li class="sum-tl-item">
										<span class="sum-tl-dot" aria-hidden="true">✦</span>
										<div class="sum-tl-body">
											<p class="sum-tl-date">{ev.date}</p>
											<p class="sum-tl-title">{ev.title}</p>
											{ev.note && <p class="sum-tl-note">{ev.note}</p>}
										</div>
									</li>
								))}
							</ol>
						</div>
					)}

					<!-- 年度关键词 -->
					{b.annual?.keywords && b.annual.keywords.length > 0 && (
						<div class="sum-section">
							<h2 class="sum-sec-title"><span class="sum-sec-no">03</span> 年度关键词</h2>
							<div class="sum-tags">
								{b.annual.keywords.map((k) => (
									<span class="sum-tag">{k}</span>
								))}
							</div>
						</div>
					)}

					<!-- 进步与遗憾 -->
					{(b.annual?.growth?.length > 0 || b.annual?.regrets?.length > 0) && (
						<div class="sum-section">
							<h2 class="sum-sec-title"><span class="sum-sec-no">04</span> 进步与遗憾</h2>
							<div class="sum-gr">
								{b.annual?.growth && b.annual.growth.length > 0 && (
									<div class="sum-gr-col sum-gr-growth">
										<h3 class="sum-gr-head">这一年的进步</h3>
										<ul class="sum-gr-list">
											{b.annual.growth.map((g) => (
												<li>{g}</li>
											))}
										</ul>
									</div>
								)}
								{b.annual?.regrets && b.annual.regrets.length > 0 && (
									<div class="sum-gr-col sum-gr-regrets">
										<h3 class="sum-gr-head">这一年的遗憾</h3>
										<ul class="sum-gr-list">
											{b.annual.regrets.map((g) => (
												<li>{g}</li>
											))}
										</ul>
									</div>
								)}
							</div>
						</div>
					)}

					<!-- 下一年期许 -->
					{b.annual?.outlook && (
						<div class="sum-section">
							<h2 class="sum-sec-title"><span class="sum-sec-no">05</span> 下一年的期许</h2>
							<p class="sum-outlook">「{b.annual.outlook}」</p>
						</div>
					)}

					<!-- 该年月度档案入口 -->
					{b.monthly.length > 0 && !b.hideMonthly && (
						<div class="sum-section sum-month-entry">
							<h2 class="sum-sec-title">去翻阅月度档案</h2>
							<div class="sum-pills">
								{b.monthly.map((m) => (
									<button
										type="button"
										class="sum-pill"
										data-goto-month={m.month}
									>
										{m.monthLabel}
									</button>
								))}
							</div>
						</div>
					)}
								</>
								) : (
									<div class="sum-empty">
										<p class="sum-empty-mark" aria-hidden="true">✦</p>
										<p class="sum-empty-title">{b.year} 年的年度总结还没有写</p>
										<p class="sum-empty-hint">
											在 src/content/spec/journal-{b.year}.md 的 frontmatter 里添加
											<code>annual:</code> 字段即可。
										</p>
									</div>
								)}
							</article>
						))}
					</section>

		<!-- ══ 月度视图（琥珀 · 叙事档案） ══ -->
		<section class="sum-pane" data-sum-pane="monthly" hidden>
			{monthlyBooks.map((g) => (
				<div class="sum-m-year" data-sum-month-group={g.year} hidden={g.year !== activeYear}>
					<p class="sum-m-year-label">{g.year} 年</p>
					{g.monthly.length > 0 ? (
					<>
					<div class="sum-pills sum-m-pills">
						{g.monthly.map((m) => (
							<button
								type="button"
								class="sum-pill"
								data-sum-month={m.month}
							>
								{m.monthLabel}
							</button>
						))}
					</div>

					{g.monthly.map((m) => (
						<article
							class="sum-m-doc"
							data-sum-month-doc={m.month}
							hidden={m.month !== firstMonthKey}
						>
							{/* 扉页 */}
							<header class="sum-m-cover">
								<span class="sum-m-badge" aria-hidden="true">
									{m.monthLabel}
								</span>
								<p class="sum-m-theme">{m.theme ?? "这个月的故事"}</p>
							</header>

							{/* 正文区 */}
							{m.paragraphs.length > 0 && (
								<div class="sum-m-body">
									{m.paragraphs.map((para) => (
										<p>{para}</p>
									))}
								</div>
							)}

							{/* 情感时间线（故事主体） */}
							{m.events && m.events.length > 0 && (
								<div class="sum-m-section">
									<h2 class="sum-m-sec-title">这个月，发生了什么</h2>
									<ol class="sum-m-events">
										{m.events.map((ev, i) => (
											<li class="sum-m-event" style={{ "--m-ev-rot": `${i % 2 === 0 ? -0.6 : 0.6}deg` }}>
												<div class="sum-m-ev-head">
													{ev.date && <span class="sum-m-ev-date">{ev.date}</span>}
													<span class="sum-m-ev-title">{ev.title}</span>
													{ev.mood && (
														<Icon name={ev.mood} class="sum-m-ev-mood" />
													)}
												</div>
												<p class="sum-m-ev-text">{ev.text}</p>
											</li>
										))}
									</ol>
								</div>
							)}

							{/* 情绪小径 */}
							{m.events && m.events.filter((e) => e.mood).length > 0 && (
								<div class="sum-m-section">
									<h2 class="sum-m-sec-title">这个月的心情</h2>
									<div class="sum-m-moodpath">
										{m.events
											.filter((e) => e.mood)
											.map((ev) => (
												<span class="sum-m-moodstep">
													<Icon name={ev.mood!} class="sum-m-moodicon" />
													{ev.title && <em class="sum-m-moodlabel">{ev.title}</em>}
												</span>
											))}
									</div>
								</div>
							)}

							{/* 亮点瞬间 */}
							{m.moments && m.moments.length > 0 && (
								<div class="sum-m-section">
									<h2 class="sum-m-sec-title">值得记住的瞬间</h2>
									<div class="sum-m-moments">
										{m.moments.map((mo) => (
											<span class="sum-m-moment">✦ {mo}</span>
										))}
									</div>
								</div>
							)}

							{/* 月尾金句 */}
							{m.quote && <p class="sum-m-quote">「{m.quote}」</p>}
						</article>
					))}
					</>
					) : (
						<div class="sum-empty">
							<p class="sum-empty-mark" aria-hidden="true">✦</p>
							<p class="sum-empty-title">{g.year} 年的月度档案还没有写</p>
							<p class="sum-empty-hint">
								在 src/content/spec/journal-{g.year}.md 的 frontmatter 里添加
								<code>monthly:</code> 字段即可。
							</p>
						</div>
					)}
				</div>
			))}
		</section>
	</div>

	<script is:inline data-astro-rerun>
		(function () {
			function initSummary() {
				var root = document.getElementById("sum-app");
				if (!root || root.dataset.init === "1") return;
				root.dataset.init = "1";
				var tabs = Array.from(root.querySelectorAll("[data-sum-tab]"));
				var panes = Array.from(root.querySelectorAll("[data-sum-pane]"));

				function showPane(name) {
					panes.forEach(function (p) {
						p.hidden = p.dataset.sumPane !== name;
					});
					tabs.forEach(function (t) {
						t.classList.toggle("sum-tab-active", t.dataset.sumTab === name);
					});
				}

				function selectMonth(y, m) {
					var pills = root.querySelectorAll(
						'[data-sum-month-group="' + y + '"] [data-sum-month]'
					);
					pills.forEach(function (p) {
						p.classList.toggle("sum-pill-active", p.dataset.sumMonth === m);
					});
					var docs = root.querySelectorAll("[data-sum-month-doc]");
					docs.forEach(function (d) {
						d.hidden = d.dataset.sumMonthDoc !== m;
					});
				}

				// 返回按钮：回到手账之前的位置（带 year/page，一步到位，避免先封面再跳页）
				var backBtn = root.querySelector("[data-sum-back]");
				if (backBtn) {
					backBtn.addEventListener("click", function (e) {
						e.preventDefault();
						var y = root.dataset.defaultYear || "";
						var p = 0;
						try {
							var st = JSON.parse(localStorage.getItem("journal-state") || "null");
							if (st && st.year) y = st.year;
							if (st && typeof st.page === "number") p = st.page;
						} catch (err) {}
						window.location.assign(
							"/journal/?year=" +
								encodeURIComponent(y) +
								"&page=" +
								p +
								"#main-grid"
						);
					});
				}

				// 统一切换年份：顶部年份按钮高亮 + 年度视图显隐 + 月度分组显隐 + 选中该年第一月
				var yearBtnEls = Array.from(root.querySelectorAll("[data-sum-year-btn]"));
				var annualDocs = Array.from(root.querySelectorAll("[data-sum-annual-year]"));

				function switchYear(y) {
					yearBtnEls.forEach(function (b) {
						b.classList.toggle("sum-year-btn-active", b.dataset.sumYearBtn === y);
					});
					annualDocs.forEach(function (d) {
						d.hidden = d.dataset.sumAnnualYear !== y;
					});
					root.querySelectorAll("[data-sum-month-group]").forEach(function (g) {
						g.hidden = g.dataset.sumMonthGroup !== y;
					});
					var first = root.querySelector(
						'[data-sum-month-group="' + y + '"] [data-sum-month]'
					);
					if (first) selectMonth(y, first.dataset.sumMonth);
					try {
						history.replaceState(null, "", "?year=" + y);
					} catch (e) {}
				}

				yearBtnEls.forEach(function (b) {
					b.addEventListener("click", function () {
						switchYear(b.dataset.sumYearBtn);
						saveView(null, b.dataset.sumYearBtn, null);
					});
				});

				tabs.forEach(function (t) {
					t.addEventListener("click", function () {
						showPane(t.dataset.sumTab);
						saveView(t.dataset.sumTab);
					});
				});

				// 月度视图里的年份分组（点击同等于顶部年份按钮）
				root.querySelectorAll("[data-sum-month-group]").forEach(function (g) {
					var label = g.querySelector(".sum-m-year-label");
					if (!label) return;
					label.style.cursor = "pointer";
					label.addEventListener("click", function () {
						switchYear(g.dataset.sumMonthGroup);
						saveView("monthly", g.dataset.sumMonthGroup, null);
					});
				});

				// 月份胶囊 + 年度页入口：点击 → 切到月度视图并选中该月
				root.querySelectorAll("[data-sum-month], [data-goto-month]").forEach(function (el) {
					el.addEventListener("click", function () {
						var m = el.dataset.sumMonth || el.dataset.gotoMonth;
						var y = m.slice(0, 4);
						showPane("monthly");
						switchYear(y);
						selectMonth(y, m);
						saveView("monthly", y, m);
					});
				});

				// 初始年份：URL ?year → 手账当前选中年份(journal-state) → 上次记忆 → 默认
				var availableYears = yearBtnEls.map(function (b) {
					return b.dataset.sumYearBtn;
				});
				var params = null;
				try {
					params = new URLSearchParams(location.search);
				} catch (e) {}
				var urlYear = params && params.get("year") ? params.get("year") : null;
				var journalYear = null;
				try {
					var st = JSON.parse(localStorage.getItem("journal-state") || "null");
					journalYear = st && st.year ? st.year : null;
				} catch (e) {}
				var saved = null;
				try {
					saved = JSON.parse(localStorage.getItem("journal-summary") || "null");
				} catch (e) {}
				var defYear = root.dataset.defaultYear;
				var defMonth = root.dataset.defaultMonth;
				var v = saved && saved.view ? saved.view : "annual";
				var y =
					urlYear ||
					journalYear ||
					(saved && saved.year ? saved.year : null) ||
					defYear;
				if (availableYears.indexOf(y) === -1) y = defYear;
				var m = saved && saved.month ? saved.month : defMonth;
				showPane(v);
				switchYear(y);
				if (v === "monthly" && m && m.slice(0, 4) === y) {
					selectMonth(y, m);
				}

				function saveView(view, year, month) {
					try {
						localStorage.setItem(
							"journal-summary",
							JSON.stringify({
								view: view,
								year: year || root.dataset.defaultYear,
								month: month || null,
							})
						);
					} catch (e) {}
				}

				// 全屏壁纸模式定位：总结页被 data-no-swup 整页加载（绕过 Swup 的 scroll:top 钩子），
				// 这里手动复刻 Layout.astro scroll:top 钩子的逻辑：
				// 全屏壁纸模式 + 非首页 → 滚动到 #main-grid（正文容器顶部），避免停在壁纸顶部
				function scrollToContentIfFullscreen() {
					try {
						if (
							document.documentElement.getAttribute("data-wallpaper-mode") !==
							"fullscreen"
						)
							return;
						if (window.location.pathname.replace(/\/+$/, "") === "") return; // 首页不滚
						var mainGrid = document.getElementById("main-grid");
						if (mainGrid) mainGrid.scrollIntoView({ behavior: "auto" });
					} catch (e) {}
				}
				// 时机：等 DOMContentLoaded 同步初始化（initWallpaperMode 已把主内容定位到壁纸下方并显示）后再滚动，
				// 避免整页加载时先在壁纸位置滚动导致"闪一下壁纸"；load 兜底保证图片/字体就绪后位置正确
				if (document.readyState === "loading") {
					document.addEventListener("DOMContentLoaded", function () {
						setTimeout(scrollToContentIfFullscreen, 0);
					});
				} else {
					scrollToContentIfFullscreen();
				}
				window.addEventListener("load", scrollToContentIfFullscreen);
			}

			initSummary();
			if (!window.__summaryBound) {
				window.__summaryBound = true;
